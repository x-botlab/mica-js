{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": [],
    "paths": {
      "@mica-js/core/lifecycle": ["../../packages/core/src/lifecycle/index.ts"]
    }
  },
  "include": ["../../packages/conformance/src/adapter.d.ts", "devices/**/*.ts", "devices/**/*.js"]
}
