{
  "name": "@mica-js/simulator",
  "version": "2.0.0",
  "description": "Synchronous compiled device simulation runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x-botlab/mica-js.git",
    "directory": "packages/simulator"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./device": {
      "source": "./src/device.ts",
      "types": "./dist/device.d.ts",
      "import": "./dist/device.js"
    },
    "./model": {
      "source": "./src/model.ts",
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./ddl": {
      "source": "./src/ddl.ts",
      "types": "./dist/ddl.d.ts",
      "import": "./dist/ddl.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test bench/*.test.mjs",
    "bench": "node bench/runtime.mjs",
    "bench:electrical": "node bench/electrical.mjs",
    "bench:workloads": "node bench/workloads.mjs",
    "bench:propagation": "node bench/propagation.mjs",
    "bench:mcu": "node bench/mcu.mjs",
    "bench:mcu:typical": "node bench/typical-mcu.mjs"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./device": {
        "types": "./dist/device.d.ts",
        "import": "./dist/device.js"
      },
      "./model": {
        "types": "./dist/model.d.ts",
        "import": "./dist/model.js"
      },
      "./ddl": {
        "types": "./dist/ddl.d.ts",
        "import": "./dist/ddl.js"
      }
    }
  },
  "dependencies": {
    "@mica-js/compiler": "workspace:*",
    "@mica-js/device-model": "workspace:*",
    "@mica-js/ddl": "workspace:*",
    "@mica-js/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  }
}
