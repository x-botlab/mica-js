{
  "name": "@mica-js/simulator",
  "version": "0.2.1",
  "description": "Mica simulator: runs the device instances of a schematic on one virtual clock",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x-botlab/mica-js.git",
    "directory": "packages/simulator"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sandbox": {
      "source": "./src/sandbox.ts",
      "types": "./dist/sandbox.d.ts",
      "import": "./dist/sandbox.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "bench": "vitest bench --run",
    "bench:unified": "vitest bench --run bench/unified-simple.bench.ts",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.bench.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./sandbox": {
        "types": "./dist/sandbox.d.ts",
        "import": "./dist/sandbox.js"
      }
    }
  },
  "dependencies": {
    "@mica-js/core": "workspace:*",
    "@mica-js/device": "workspace:*",
    "@mica-js/ir": "workspace:*",
    "@mica-js/sandbox": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
