{
  "name": "@mica-js/canvas-editor",
  "version": "0.3.3",
  "description": "Mica canvas editor: composites .cnv widgets onto one canvas and turns user input into CanvasCommand",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x-botlab/mica-js.git",
    "directory": "packages/canvas-editor"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./style.css": "./dist/style.css"
    }
  },
  "dependencies": {
    "@mica-js/core": "workspace:*",
    "@mica-js/sandbox": "workspace:*",
    "@mica-js/simulator": "workspace:*",
    "@mica-js/widget": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
