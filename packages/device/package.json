{
  "name": "@mica-js/device",
  "version": "0.1.0",
  "description": "Mica device layer: description parsing, provider loading and fixed instance properties",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x-botlab/mica-js.git",
    "directory": "packages/device"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "prepack": "pnpm -r --filter \"@mica-js/device...\" build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mica-js/core": "workspace:*",
    "@mica-js/ir": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
