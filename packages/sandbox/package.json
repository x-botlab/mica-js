{
  "name": "@mica-js/sandbox",
  "version": "0.2.0",
  "description": "Mica sandbox: run untrusted guest JavaScript in an iframe + Web Worker isolated environment",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x-botlab/mica-js.git",
    "directory": "packages/sandbox"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
