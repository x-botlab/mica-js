{
  "name": "@mica-js/device-model",
  "version": "0.6.0",
  "description": "Device IR contracts, validation and typed construction",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x-botlab/mica-js.git",
