{
  "name": "@mica-js/widget",
  "version": "0.3.1",
  "description": "Mica widget contract and runtime: author definitions, package loading, and sandboxed instance execution",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x-botlab/mica-js.git",
    "directory": "packages/widget"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./author": {
      "source": "./src/author.ts",
      "types": "./dist/author.d.ts",
      "import": "./dist/author.js"
    },
    "./vite": {
      "source": "./src/build/vite.ts",
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./author": {
        "types": "./dist/author.d.ts",
        "import": "./dist/author.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "import": "./dist/vite.js"
      }
    }
  },
  "dependencies": {
    "@mica-js/core": "workspace:*",
    "@mica-js/sandbox": "workspace:*",
    "rolldown": "catalog:",
    "@mica-js/document": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
