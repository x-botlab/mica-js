{
  "kind": "device",
  "id": "ct117e-m4",
  "version": "0.1.0",
  "displayName": "CT117E-M4 MCU + LCD",
  "description": "STM32G431RBT6 与 ILI9325 的单实例融合器件，固定 3.3 V 理想数字内部总线。",
  "designatorPrefix": "U",
  "tags": ["ct117e-m4", "stm32", "cortex-m4", "ili9325", "rgb565"],
  "properties": {
    "firmware": {
      "type": "bytes",
      "required": false,
      "title": "Flash 固件映像",
      "description": "从 0x08000000 开始的二进制字节映像；HEX 文本需先解析。",
      "editor": { "kind": "file" }
    },
    "clockFrequency": {
      "type": "number",
      "required": false,
      "default": 80000000,
      "title": "主频 (Hz)",
      "editor": { "kind": "number", "min": 1000, "max": 170000000, "step": 1 }
    },
    "refreshRate": {
      "type": "number",
      "required": false,
      "default": 60,
      "title": "合帧最大频率 (Hz)",
      "editor": { "kind": "number", "min": 1, "max": 240, "step": 1 }
    }
  },
  "pins": {
    "VDD1": { "label": "VDD", "group": "POWER", "description": "固定 3.3 V 供电" },
    "VSS1": { "label": "VSS", "group": "POWER", "description": "地" }
  },
  "ports": {
    "framebuffer": {
      "direction": "output",
      "type": "bytes<rgb565>",
      "delivery": "level",
      "title": "LCD 帧缓冲",
      "description": "320×240 面板脏矩形：小端 u16 x/y/width/height 头及行优先 RGB565 像素。"
    },
    "fault": {
      "direction": "output",
      "type": "number",
      "delivery": "message",
      "title": "MCU 故障"
    },
    "serial1.tx": {
      "direction": "output",
      "type": "number",
      "delivery": "message",
      "title": "USART1 TX"
    },
    "serial2.tx": {
      "direction": "output",
      "type": "number",
      "delivery": "message",
      "title": "USART2 TX"
    },
    "serial3.tx": {
      "direction": "output",
      "type": "number",
      "delivery": "message",
      "title": "USART3 TX"
    }
  },
  "symbol": {
    "bounds": { "x": -90, "y": -60, "width": 180, "height": 120 },
    "graphics": [
      { "type": "rect", "x": -80, "y": -50, "width": 160, "height": 100, "fill": "background" },
      {
        "type": "text",
        "position": [0, -20],
        "text": "CT117E-M4",
        "align": "center",
        "fontSize": 12
      },
      { "type": "text", "position": [0, 0], "text": "MCU + LCD", "align": "center", "fontSize": 10 }
    ],
    "pins": {
      "VDD1": { "position": [-90, 20], "direction": "left", "label": { "visible": true } },
      "VSS1": { "position": [90, 20], "direction": "right", "label": { "visible": true } }
    },
    "annotations": { "designator": { "position": [0, -40], "align": "center" } }
  }
}
