{
  "name": "ct117e-m4",
  "publisher": "example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CT117E-M4 单器件融合工程：STM32G431RBT6 与 ILI9325 固定数字总线",
  "license": "MIT",
  "engines": {
    "mica": "^1.0.0"
  },
  "displayName": "CT117E-M4 MCU + LCD",
  "designatorPrefix": "U",
  "properties": {
    "firmware": {
      "type": "program",
      "title": "Flash 固件映像",
      "description": "从 0x08000000 开始的 BIN / Intel HEX / ELF 固件来源。",
      "default": null,
      "nullable": true,
      "addressSpaces": {
        "flash": {
          "title": "STM32G431RBT6 Flash",
          "start": 134217728,
          "size": 131072
        }
      },
      "loader": "memory",
      "formats": [
        "bin",
        "hex",
        "elf"
      ],
      "defaults": {
        "addressSpace": "flash",
        "loadAddress": 134217728
      }
    },
    "clockFrequency": {
      "type": "integer",
      "title": "主频 (Hz)",
      "default": 80000000,
      "nullable": false,
      "min": 1000,
      "max": 170000000,
      "step": 1
    },
    "hseFrequency": {
      "type": "integer",
      "title": "HSE 晶振频率 (Hz)",
      "description": "0 表示未焊晶振，HSERDY 永远为 0；非 0 时必须在 1..50 MHz。",
      "default": 0,
      "nullable": false,
      "min": 0,
      "max": 50000000,
      "step": 1
    },
    "refreshRate": {
      "type": "integer",
      "title": "合帧最大频率 (Hz)",
      "default": 60,
      "nullable": false,
      "min": 1,
      "max": 240,
      "step": 1
    }
  },
  "pins": {
    "VDD1": {
      "label": "VDD",
      "description": "固定 3.3 V 供电"
    },
    "VSS1": {
      "label": "VSS",
      "description": "地"
    },
    "NRST": {
      "label": "NRST",
      "description": "外部复位输入；低电平保持 MCU halted，释放沿从向量表重启"
    }
  },
  "model": {
    "entry": "model.js",
    "types": {},
    "methods": {
      "getFramebuffer": {
        "params": {
          "type": "null"
        },
        "returns": {
          "type": "binary"
        }
      }
    },
    "events": {
      "onDidFramebuffer": {
        "type": "binary"
      },
      "onDidFault": {
        "type": "number"
      },
      "onDidSerial1Tx": {
        "type": "number"
      },
      "onDidSerial2Tx": {
        "type": "number"
      },
      "onDidSerial3Tx": {
        "type": "number"
      }
    }
  },
  "scripts": {
    "prepare:types": "node scripts/prepare-model.mjs && mica prepare",
    "build": "node scripts/prepare-model.mjs && mica build",
    "typecheck": "pnpm prepare:types && tsc --noEmit",
    "test": "pnpm build && vitest run --config vitest.config.ts",
    "bench": "pnpm build && vitest run --config vitest.perf.config.ts"
  },
  "devDependencies": {
    "@mica-js/core": "workspace:*",
    "@mica-js/example-devices": "workspace:*",
    "@mica-js/sdk": "workspace:*",
    "@mica-js/simulator": "workspace:*",
    "@mica-js/stm32g431rbt6-core": "workspace:*",
    "@types/node": "^24.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
