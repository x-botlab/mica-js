{
  "name": "ct117e-m4",
  "publisher": "example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CT117E-M4 单器件融合工程：STM32G431RBT6 与 ILI9325 固定数字总线",
  "license": "MIT",
  "engines": {
    "mica": "^0.3.0"
  },
  "displayName": "CT117E-M4 MCU + LCD",
  "designatorPrefix": "U",
  "properties": {
    "firmware": {
      "type": "firmware",
      "title": "Flash 固件映像",
      "description": "从 0x08000000 开始的 BIN / Intel HEX / ELF 固件来源。",
      "default": null,
      "nullable": true,
      "maxBytes": 131072,
      "addressSpaces": {
        "flash": {
          "title": "STM32G431RBT6 Flash",
          "start": 134217728,
          "size": 131072
        }
      },
      "addressSpace": "flash",
      "loadAddress": 134217728
    },
    "clockFrequency": {
      "type": "integer",
      "title": "主频 (Hz)",
      "default": 80000000,
      "nullable": false,
      "min": 1000,
      "max": 170000000,
      "step": 1
    },
    "refreshRate": {
      "type": "integer",
      "title": "合帧最大频率 (Hz)",
      "default": 60,
      "nullable": false,
      "min": 1,
      "max": 240,
      "step": 1
    }
  },
  "pins": {
    "VDD1": {
      "label": "VDD",
      "description": "固定 3.3 V 供电"
    },
    "VSS1": {
      "label": "VSS",
      "description": "地"
    }
  },
  "model": {
    "entry": "model.js",
    "types": {},
    "methods": {
      "getFramebuffer": {
        "params": {
          "type": "null"
        },
        "returns": {
          "type": "binary"
        }
      }
    },
    "events": {
      "onDidFramebuffer": {
        "type": "binary"
      },
      "onDidFault": {
        "type": "number"
      },
      "onDidSerial1Tx": {
        "type": "number"
      },
      "onDidSerial2Tx": {
        "type": "number"
      },
      "onDidSerial3Tx": {
        "type": "number"
      }
    }
  },
  "scripts": {
    "prepare:types": "node scripts/prepare-model.mjs && mica prepare",
    "build": "node scripts/prepare-model.mjs && mica build",
    "typecheck": "pnpm prepare:types && tsc --noEmit",
    "test": "pnpm build && vitest run --config vitest.config.ts",
    "bench": "pnpm build && vitest run --config vitest.perf.config.ts"
  },
  "devDependencies": {
    "@mica-js/example-devices": "workspace:*",
    "@mica-js/sdk": "workspace:*",
    "@mica-js/simulator": "workspace:*",
    "@mica-js/stm32g431rbt6-core": "workspace:*",
    "@types/node": "^24.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
