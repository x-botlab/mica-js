{
  "kind": "device",
  "id": "buzzer",
  "version": "1.0.0",
  "displayName": "有源蜂鸣器",
  "designatorPrefix": "SP",
  "description": "有源蜂鸣器：两端之间是负载电阻，正端为高、负端非高时发声；端口 active 报告是否发声。CT107D 的 SP1，正端接 VCC、负端接 ULN2003 OUT7。不模拟发声频率、声压与机械共振。",
  "tags": ["buzzer", "actuator", "audio", "ct107d"],
  "properties": {
    "loadResistance": {
      "type": "number",
      "required": false,
      "default": 100,
      "title": "负载电阻",
      "unit": "ohm",
      "description": "两端的等效串联电阻，决定开集驱动拉低时的电流。",
      "editor": { "kind": "number", "min": 0.001, "max": 1000000000, "step": 1 }
    },
    "lowThreshold": {
      "type": "number",
      "required": false,
      "default": 0.8,
      "title": "低电平上限",
      "unit": "V",
      "description": "采样电压低于该值判为逻辑低。",
      "editor": { "kind": "number", "min": 0, "max": 5, "step": 0.1 }
    },
    "highThreshold": {
      "type": "number",
      "required": false,
      "default": 2,
      "title": "高电平下限",
      "unit": "V",
      "description": "采样电压高于该值判为逻辑高。",
      "editor": { "kind": "number", "min": 0, "max": 5, "step": 0.1 }
    }
  },
  "pins": {
    "p": { "label": "+", "description": "正端，板上接 VCC", "group": "Power" },
    "n": { "label": "-", "description": "负端，板上接 ULN2003 OUT7（N_BUZZ）", "group": "Drive" }
  },
  "ports": {
    "active": {
      "direction": "output",
      "type": "boolean",
      "delivery": "level",
      "title": "发声",
      "description": "正端为高且负端非高时为 true，即两端有电压、蜂鸣器发声。"
    }
  },
  "symbol": {
    "bounds": { "x": -32, "y": -22, "width": 64, "height": 44 },
    "graphics": [
      { "type": "line", "from": [-32, 0], "to": [-14, 0] },
      { "type": "rect", "x": -14, "y": -10, "width": 8, "height": 20 },
      {
        "type": "polyline",
        "points": [
          [-6, -10],
          [10, -20],
          [10, 20],
          [-6, 10]
        ],
        "closed": true
      },
      { "type": "line", "from": [10, 0], "to": [32, 0] },
      { "type": "arc", "center": [16, 0], "radius": 12, "startAngle": -50, "sweepAngle": 100 }
    ],
    "pins": {
      "p": { "position": [-32, 0], "direction": "left", "label": { "visible": false } },
      "n": { "position": [32, 0], "direction": "right", "label": { "visible": false } }
    },
    "annotations": { "designator": { "position": [0, -24], "align": "center" } }
  }
}
