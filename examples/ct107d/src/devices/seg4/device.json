{
  "kind": "device",
  "id": "seg4",
  "version": "1.0.0",
  "displayName": "四位数码管",
  "description": "共阴四位七段数码管：8 段阳极与 4 位公共阴极之间各是一段等效串联电阻；扫描选中某一位时锁存该时刻的段码（bit0=a…bit7=dp），保持到下一次选中。",
  "designatorPrefix": "DS",
  "tags": ["display", "led", "seven-segment", "multiplexed"],
  "properties": {
    "forwardResistance": {
      "type": "number",
      "required": false,
      "default": 500,
      "title": "段等效电阻",
      "unit": "ohm",
      "description": "段阳极到公共阴极的等效串联电阻。与 blue-led 相同，线性模型不含正向压降；板级限流电阻可并入本值（例如 1 kΩ 串联时取 1500）。",
      "editor": {
        "kind": "number",
        "min": 0.001,
        "max": 1000000000,
        "step": 1
      }
    }
  },
  "pins": {
    "a": {
