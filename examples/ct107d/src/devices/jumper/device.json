{
  "kind": "device",
  "id": "jumper",
  "version": "1.0.0",
  "displayName": "两脚跳线",
  "designatorPrefix": "J",
  "description": "装配期配置的两脚跳线：closed 为 true 时两端导通（0.05 Ω），false 时断开（1 GΩ）。CT107D 的 J13（WR 源选择）与 JS1/JS2。运行期不可切换，因此没有输入端口。",
  "tags": ["jumper", "header", "ct107d"],
  "properties": {
    "closed": {
      "type": "boolean",
      "required": false,
      "default": true,
      "title": "短接",
      "description": "true 表示插上跳线帽（两端导通），false 表示拔掉。",
      "editor": { "kind": "checkbox" }
    },
    "resistance": {
      "type": "number",
      "required": false,
      "default": 0.05,
      "title": "短接电阻",
      "unit": "ohm",
      "description": "插上跳线帽时两端的等效导通电阻。",
      "editor": { "kind": "number", "min": 0.001, "max": 1000000, "step": 0.01 }
    },
    "openResistance": {
      "type": "number",
      "required": false,
      "default": 1000000000,
      "title": "断开电阻",
      "unit": "ohm",
      "description": "拔掉跳线帽时两端的等效绝缘电阻；用有限值避免孤立支路。",
      "editor": { "kind": "number", "min": 1, "max": 1000000000000, "step": 1000 }
    }
  },
  "pins": {
    "a": { "label": "A" },
    "b": { "label": "B" }
  },
  "ports": {},
  "symbol": {
    "bounds": { "x": -32, "y": -16, "width": 64, "height": 32 },
    "graphics": [
      { "type": "line", "from": [-32, 0], "to": [-10, 0] },
      { "type": "circle", "center": [-6, 0], "radius": 4 },
      { "type": "circle", "center": [6, 0], "radius": 4 },
      { "type": "rect", "x": -10, "y": -8, "width": 20, "height": 16, "fill": "background" },
      { "type": "line", "from": [10, 0], "to": [32, 0] }
    ],
    "pins": {
      "a": { "position": [-32, 0], "direction": "left", "label": { "visible": false } },
      "b": { "position": [32, 0], "direction": "right", "label": { "visible": false } }
    },
    "annotations": { "designator": { "position": [0, -18], "align": "center" } }
  }
}
