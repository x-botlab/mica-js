  fn fusedRefresh() {
    if fusedButtonDirty {
      fusedButtonDirty = false;
      fusedComputeButtons();
    }
    fusedRefreshBody();
    if fusedLedDirty {
      fusedLedDirty = false;
      publishLeds();
    }
    if fusedActuatorDirty {
      fusedActuatorDirty = false;
      publishActuators();
    }
  }

  /** Power-up only: materialise every MCU pin before the first firmware instruction. */
  fn fusedRefreshInitial() {
    fusedComputeButtons();
    fusedRefreshAllBody();
    publishLeds();
    publishActuators();
  }

  process fusedWireRefresh on fusedSeq {
    fusedRefresh();
  }

  // ---------------------------------------------------------------------------------------
  // Board observables
  // ---------------------------------------------------------------------------------------

  pure fn fusedBit(value: number, bit: number) -> bool {
    return ((value >> bit) & 1) == 1;
  }

  fn publishLeds() {
    let bits = 0;
    let ready = true;
    if fusedNet51() == 0 { bits = bits | 1; }
    else if fusedNet51() == 2 { ready = false; }
    if fusedNet52() == 0 { bits = bits | 2; }
    else if fusedNet52() == 2 { ready = false; }
    if fusedNet53() == 0 { bits = bits | 4; }
    else if fusedNet53() == 2 { ready = false; }
    if fusedNet54() == 0 { bits = bits | 8; }
    else if fusedNet54() == 2 { ready = false; }
    if fusedNet55() == 0 { bits = bits | 16; }
    else if fusedNet55() == 2 { ready = false; }
    if fusedNet56() == 0 { bits = bits | 32; }
    else if fusedNet56() == 2 { ready = false; }
    if fusedNet57() == 0 { bits = bits | 64; }
    else if fusedNet57() == 2 { ready = false; }
    if fusedNet58() == 0 { bits = bits | 128; }
    else if fusedNet58() == 2 { ready = false; }
    // Do not publish a fabricated off state before the latch has driven all LED nets.
    if !ready { return; }
    if bits == ledMask && ledsInitialized { return; }
    ledMask = bits;
    ledsInitialized = true;
    const current = bits == 0 ? 0 : 5 / (1500 + 25);
    const voltage = bits == 0 ? 0 : 5 * 1500 / (1500 + 25);
    const brightness = bits == 0 ? 0 : (5 / (1500 + 25)) / 0.02;
    led.send({ index: 0, brightness: fusedBit(bits, 0) ? brightness : 0, current: fusedBit(bits, 0) ? current : 0, voltage: fusedBit(bits, 0) ? voltage : 0 });
    led.send({ index: 1, brightness: fusedBit(bits, 1) ? brightness : 0, current: fusedBit(bits, 1) ? current : 0, voltage: fusedBit(bits, 1) ? voltage : 0 });
    led.send({ index: 2, brightness: fusedBit(bits, 2) ? brightness : 0, current: fusedBit(bits, 2) ? current : 0, voltage: fusedBit(bits, 2) ? voltage : 0 });
    led.send({ index: 3, brightness: fusedBit(bits, 3) ? brightness : 0, current: fusedBit(bits, 3) ? current : 0, voltage: fusedBit(bits, 3) ? voltage : 0 });
    led.send({ index: 4, brightness: fusedBit(bits, 4) ? brightness : 0, current: fusedBit(bits, 4) ? current : 0, voltage: fusedBit(bits, 4) ? voltage : 0 });
    led.send({ index: 5, brightness: fusedBit(bits, 5) ? brightness : 0, current: fusedBit(bits, 5) ? current : 0, voltage: fusedBit(bits, 5) ? voltage : 0 });
    led.send({ index: 6, brightness: fusedBit(bits, 6) ? brightness : 0, current: fusedBit(bits, 6) ? current : 0, voltage: fusedBit(bits, 6) ? voltage : 0 });
    led.send({ index: 7, brightness: fusedBit(bits, 7) ? brightness : 0, current: fusedBit(bits, 7) ? current : 0, voltage: fusedBit(bits, 7) ? voltage : 0 });
  }

  fn publishActuators() {
    const relay = fusedNet89() == 0;
    const buzzer = fusedNet91() == 0;
    const relayChanged = !actuatorsInitialized || relay != relayEnergized;
    const buzzerChanged = !actuatorsInitialized || buzzer != buzzerActive;
    relayEnergized = relay;
    buzzerActive = buzzer;
    if relayChanged {
      actuator.send({ target: 0, active: relay, value: 0 });
    }
    if buzzerChanged {
      actuator.send({ target: 1, active: buzzer, value: 0 });
    }
    // The bounded history above can drop changes of one target behind noise from the
    // other. Every refresh that changes anything carries the complete latest state.
    if !actuatorsInitialized || relayChanged || buzzerChanged {
      actuatorState.send({ relay: relay, buzzer: buzzer });
    }
    actuatorsInitialized = true;
  }

  pure fn segmentMask() -> number {
    let mask = 0;
    if fusedNet59() == 0 { mask = mask | 1; }
    if fusedNet60() == 0 { mask = mask | 2; }
    if fusedNet61() == 0 { mask = mask | 4; }
    if fusedNet62() == 0 { mask = mask | 8; }
    if fusedNet63() == 0 { mask = mask | 16; }
    if fusedNet64() == 0 { mask = mask | 32; }
    if fusedNet65() == 0 { mask = mask | 64; }
    if fusedNet66() == 0 { mask = mask | 128; }
    return mask;
  }

  // DS1/DS2 share the same eight segment lines.
  derived dsSegmentMask: number = segmentMask();

  // Unselected digits keep the same candidate as segment data moves, so their reaction
  // and process stay asleep. Zero is a valid blank mask, distinct from -1.
  derived ds1Scan1: number = fusedNet67() == 1 ? dsSegmentMask : -1;
  derived ds1Scan2: number = fusedNet68() == 1 ? dsSegmentMask : -1;
  derived ds1Scan3: number = fusedNet69() == 1 ? dsSegmentMask : -1;
  derived ds1Scan4: number = fusedNet70() == 1 ? dsSegmentMask : -1;
  derived ds2Scan1: number = fusedNet71() == 1 ? dsSegmentMask : -1;
  derived ds2Scan2: number = fusedNet72() == 1 ? dsSegmentMask : -1;
  derived ds2Scan3: number = fusedNet73() == 1 ? dsSegmentMask : -1;
  derived ds2Scan4: number = fusedNet74() == 1 ? dsSegmentMask : -1;

  reaction trackDs1Digit1 on ds1Scan1 as (previous, current) {
    ds1Since1 = now();
  }
  reaction trackDs1Digit2 on ds1Scan2 as (previous, current) {
    ds1Since2 = now();
  }
  reaction trackDs1Digit3 on ds1Scan3 as (previous, current) {
    ds1Since3 = now();
  }
  reaction trackDs1Digit4 on ds1Scan4 as (previous, current) {
    ds1Since4 = now();
  }
  reaction trackDs2Digit1 on ds2Scan1 as (previous, current) {
    ds2Since1 = now();
  }
  reaction trackDs2Digit2 on ds2Scan2 as (previous, current) {
    ds2Since2 = now();
  }
  reaction trackDs2Digit3 on ds2Scan3 as (previous, current) {
    ds2Since3 = now();
  }
  reaction trackDs2Digit4 on ds2Scan4 as (previous, current) {
    ds2Since4 = now();
  }

  fn emitDisplay1() {
    display.send({ designator: 0, digit1: ds1Digit1, digit2: ds1Digit2, digit3: ds1Digit3, digit4: ds1Digit4 });
  }
  fn emitDisplay2() {
    display.send({ designator: 1, digit1: ds2Digit1, digit2: ds2Digit2, digit3: ds2Digit3, digit4: ds2Digit4 });
  }

  process scanDs1Digit1 on ds1Scan1 {
    if ds1Scan1 >= 0 {
      const stableAt = ds1Since1 + 50000000;
      if now() < stableAt { await ticks(stableAt - now()); }
      if ds1Scan1 >= 0 && now() - ds1Since1 >= 50000000 && ds1Digit1 != ds1Scan1 {
        ds1Digit1 = ds1Scan1;
        emitDisplay1();
      }
    }
  }
  process scanDs1Digit2 on ds1Scan2 {
    if ds1Scan2 >= 0 {
      const stableAt = ds1Since2 + 50000000;
      if now() < stableAt { await ticks(stableAt - now()); }
      if ds1Scan2 >= 0 && now() - ds1Since2 >= 50000000 && ds1Digit2 != ds1Scan2 {
        ds1Digit2 = ds1Scan2;
        emitDisplay1();
      }
    }
  }
  process scanDs1Digit3 on ds1Scan3 {
    if ds1Scan3 >= 0 {
      const stableAt = ds1Since3 + 50000000;
      if now() < stableAt { await ticks(stableAt - now()); }
      if ds1Scan3 >= 0 && now() - ds1Since3 >= 50000000 && ds1Digit3 != ds1Scan3 {
        ds1Digit3 = ds1Scan3;
        emitDisplay1();
      }
    }
  }
  process scanDs1Digit4 on ds1Scan4 {
    if ds1Scan4 >= 0 {
      const stableAt = ds1Since4 + 50000000;
      if now() < stableAt { await ticks(stableAt - now()); }
      if ds1Scan4 >= 0 && now() - ds1Since4 >= 50000000 && ds1Digit4 != ds1Scan4 {
        ds1Digit4 = ds1Scan4;
        emitDisplay1();
      }
    }
  }
  process scanDs2Digit1 on ds2Scan1 {
    if ds2Scan1 >= 0 {
      const stableAt = ds2Since1 + 50000000;
      if now() < stableAt { await ticks(stableAt - now()); }
      if ds2Scan1 >= 0 && now() - ds2Since1 >= 50000000 && ds2Digit1 != ds2Scan1 {
        ds2Digit1 = ds2Scan1;
        emitDisplay2();
      }
    }
  }
  process scanDs2Digit2 on ds2Scan2 {
    if ds2Scan2 >= 0 {
      const stableAt = ds2Since2 + 50000000;
      if now() < stableAt { await ticks(stableAt - now()); }
      if ds2Scan2 >= 0 && now() - ds2Since2 >= 50000000 && ds2Digit2 != ds2Scan2 {
        ds2Digit2 = ds2Scan2;
        emitDisplay2();
      }
    }
  }
  process scanDs2Digit3 on ds2Scan3 {
    if ds2Scan3 >= 0 {
      const stableAt = ds2Since3 + 50000000;
      if now() < stableAt { await ticks(stableAt - now()); }
      if ds2Scan3 >= 0 && now() - ds2Since3 >= 50000000 && ds2Digit3 != ds2Scan3 {
        ds2Digit3 = ds2Scan3;
        emitDisplay2();
      }
    }
  }
  process scanDs2Digit4 on ds2Scan4 {
    if ds2Scan4 >= 0 {
      const stableAt = ds2Since4 + 50000000;
      if now() < stableAt { await ticks(stableAt - now()); }
      if ds2Scan4 >= 0 && now() - ds2Since4 >= 50000000 && ds2Digit4 != ds2Scan4 {
        ds2Digit4 = ds2Scan4;
        emitDisplay2();
      }
    }
  }

  // ---------------------------------------------------------------------------------------
  // Digital input/analog glue
  // ---------------------------------------------------------------------------------------

  process consumeSwitches on fusedStarted {
    loop {
      const event = await switchEvent.receive();
      if event.index < 0 || event.index >= 24 { continue; }
      const level = event.pressed ? 1 : 0;
      if load8(keyStates, event.index) == level { continue; }
      store8(keyStates, event.index, level);
      switch.send({ index: event.index, pressed: event.pressed });
      if event.index >= 1 && event.index <= 16 { fusedButtonDirty = true; }
      fusedSeq = fusedSeq + 1;
    }
  }

  process consumeJumpers on fusedStarted {
    loop {
      const event = await jumperEvent.receive();
      if event.index == 0 { j13Closed = event.closed; }
      else if event.index == 1 { j3Closed = event.closed; }
      else if event.index == 2 { j2Vs1838 = event.closed; }
      else if event.index == 3 { j5Closed = event.closed; }
      else if event.index == 4 { j2TxToLd1 = event.closed; }
      else { continue; }
      jumper.send({ index: event.index, closed: event.closed });
      fusedMarkJumperPins(event.index);
      if event.index == 1 || event.index == 3 { fusedButtonDirty = true; }
      fusedSeq = fusedSeq + 1;
    }
  }

  process consumeAmplifier on fusedStarted {
    loop {
      const event = await amplifierEvent.receive();
      if event.field == 0 { lm324Wiper = event.value; }
      fusedAmplifier();
    }
  }

  process consumeLm324Input on fusedStarted {
    loop {
      const event = await lm324Input.receive();
      if event.field == 0 { lm324InPlus = event.value; }
      else if event.field == 1 { lm324InMinus = event.value; }
      fusedAmplifier();
    }
  }

  fn fusedAmplifier() {
    const effective = 100 + (10000 - 100) * (1 - lm324Wiper);
    const nextGain = 1 + 2 * 100000 / effective;
    let target = nextGain * (lm324InPlus - lm324InMinus);
    if target < 0 { target = 0; }
    if target > 5 { target = 5; }
    const changed = lm324Position != lm324Wiper || lm324Gain != nextGain || lm324Out != target;
    lm324Position = lm324Wiper;
    lm324Gain = nextGain;
    lm324Out = target;
    if changed {
      amplifier.send({ position: lm324Position, gain: lm324Gain, outputVoltage: target });
    }
  }

  // ---------------------------------------------------------------------------------------
  // Board start and refresh expansion
  // ---------------------------------------------------------------------------------------

  process start {
    fusedStarted = true;
    // STC15 reset ports are quasi-bidirectional with weak pull-ups. The generator reads
    // every P0-P4 pin's initial intent from the standalone MCU DDL and emits the drive
    // list once here, so the fused reset cannot drift from the source package. A first
    // `MOV A,P3` / `MOV A,P4` sees the real reset level; a strong external low still wins
    // in fusedNet. Release (4) is only for later open-drain/input modes.
    store8(fusedDrive0, 0, 2);
    store8(fusedDrive1, 0, 2);
    store8(fusedDrive2, 0, 2);
    store8(fusedDrive3, 0, 2);
    store8(fusedDrive4, 0, 2);
    store8(fusedDrive5, 0, 2);
    store8(fusedDrive6, 0, 2);
    store8(fusedDrive7, 0, 2);
    store8(fusedDrive8, 0, 2);
    store8(fusedDrive9, 0, 2);
    store8(fusedDrive10, 0, 2);
    store8(fusedDrive11, 0, 2);
    store8(fusedDrive12, 0, 2);
    store8(fusedDrive13, 0, 2);
    store8(fusedDrive14, 0, 2);
    store8(fusedDrive15, 0, 2);
    store8(fusedDrive16, 0, 2);
    store8(fusedDrive17, 0, 2);
    store8(fusedDrive18, 0, 2);
    store8(fusedDrive19, 0, 2);
    store8(fusedDrive20, 0, 2);
    store8(fusedDrive21, 0, 2);
    store8(fusedDrive22, 0, 2);
    store8(fusedDrive23, 0, 2);
    store8(fusedDrive24, 0, 2);
    store8(fusedDrive25, 0, 2);
    store8(fusedDrive26, 0, 2);
    store8(fusedDrive27, 0, 2);
    store8(fusedDrive28, 0, 2);
    store8(fusedDrive29, 0, 2);
    store8(fusedDrive30, 0, 2);
    store8(fusedDrive31, 0, 2);
    store8(fusedDrive32, 0, 2);
    store8(fusedDrive33, 0, 2);
    store8(fusedDrive34, 0, 2);
    store8(fusedDrive35, 0, 2);
    store8(fusedDrive36, 0, 2);
    store8(fusedDrive37, 0, 2);
    store8(fusedDrive38, 0, 2);
    store8(fusedDrive39, 0, 2);
        u1_started = true;
    u4_started = true;
    u5_started = true;
    u6_started = true;
    u7_started = true;
    u8_started = true;
    u9_started = true;
    u10_started = true;
    u11_started = true;
    u14_started = true;
    u15_started = true;
    u16_started = true;
    u18_started = true;
    u19_started = true;
    u20_started = true;
    u21_started = true;
    u22_started = true;
    u24_started = true;
    u25_started = true;
    uart_probe_started = true;
    ld1_started = true;
    fusedRefreshInitial();
    emitDisplay1();
    emitDisplay2();
    // Publish the same initial idle state as the discrete board devices.
    let key = 0;
    while key < 17 {
      switch.send({ index: key, pressed: false });
      key = key + 1;
    }
    jumper.send({ index: 0, closed: j13Closed });
    jumper.send({ index: 1, closed: j3Closed });
    jumper.send({ index: 2, closed: j2Vs1838 });
    jumper.send({ index: 3, closed: j5Closed });
    jumper.send({ index: 4, closed: j2TxToLd1 });
    amplifier.send({ position: lm324Position, gain: lm324Gain, outputVoltage: lm324Out });
  }

  fn fusedRefreshBody() {
    if load8(fusedDirtyGroups, 0) == 1 {
      store8(fusedDirtyGroups, 0, 0);
      if load8(fusedPinDirty, 0) == 1 {
        store8(fusedPinDirty, 0, 0);
        const next0 = fusedNet2();
        if load8(fusedPin0, 0) != next0 { store8(fusedPin0, 0, next0); }
      }
      if load8(fusedPinDirty, 1) == 1 {
        store8(fusedPinDirty, 1, 0);
        const next1 = fusedNet3();
        if load8(fusedPin1, 0) != next1 { store8(fusedPin1, 0, next1); }
      }
      if load8(fusedPinDirty, 2) == 1 {
        store8(fusedPinDirty, 2, 0);
        const next2 = fusedNet4();
        if load8(fusedPin2, 0) != next2 { store8(fusedPin2, 0, next2); }
      }
      if load8(fusedPinDirty, 3) == 1 {
        store8(fusedPinDirty, 3, 0);
        const next3 = fusedNet5();
        if load8(fusedPin3, 0) != next3 { store8(fusedPin3, 0, next3); }
      }
      if load8(fusedPinDirty, 4) == 1 {
        store8(fusedPinDirty, 4, 0);
        const next4 = fusedNet6();
        if load8(fusedPin4, 0) != next4 { store8(fusedPin4, 0, next4); }
      }
      if load8(fusedPinDirty, 5) == 1 {
        store8(fusedPinDirty, 5, 0);
        const next5 = fusedNet7();
        if load8(fusedPin5, 0) != next5 { store8(fusedPin5, 0, next5); }
      }
      if load8(fusedPinDirty, 6) == 1 {
        store8(fusedPinDirty, 6, 0);
        const next6 = fusedNet8();
        if load8(fusedPin6, 0) != next6 { store8(fusedPin6, 0, next6); }
      }
      if load8(fusedPinDirty, 7) == 1 {
        store8(fusedPinDirty, 7, 0);
        const next7 = fusedNet9();
        if load8(fusedPin7, 0) != next7 { store8(fusedPin7, 0, next7); }
      }
    }
    if load8(fusedDirtyGroups, 1) == 1 {
      store8(fusedDirtyGroups, 1, 0);
      if load8(fusedPinDirty, 8) == 1 {
        store8(fusedPinDirty, 8, 0);
        const next8 = fusedNet10();
        if load8(fusedPin8, 0) != next8 { store8(fusedPin8, 0, next8); }
      }
      if load8(fusedPinDirty, 9) == 1 {
        store8(fusedPinDirty, 9, 0);
        const next9 = fusedNet11();
        if load8(fusedPin9, 0) != next9 { store8(fusedPin9, 0, next9); }
      }
      if load8(fusedPinDirty, 10) == 1 {
        store8(fusedPinDirty, 10, 0);
        const next10 = fusedNet12();
        if load8(fusedPin10, 0) != next10 { store8(fusedPin10, 0, next10); }
      }
      if load8(fusedPinDirty, 11) == 1 {
        store8(fusedPinDirty, 11, 0);
        const next11 = fusedNet13();
        if load8(fusedPin11, 0) != next11 { store8(fusedPin11, 0, next11); }
      }
      if load8(fusedPinDirty, 12) == 1 {
        store8(fusedPinDirty, 12, 0);
        const next12 = fusedNet14();
        if load8(fusedPin12, 0) != next12 { store8(fusedPin12, 0, next12); }
      }
      if load8(fusedPinDirty, 13) == 1 {
        store8(fusedPinDirty, 13, 0);
        const next13 = fusedNet15();
        if load8(fusedPin13, 0) != next13 { store8(fusedPin13, 0, next13); }
      }
      if load8(fusedPinDirty, 14) == 1 {
        store8(fusedPinDirty, 14, 0);
        const next14 = fusedNet16();
        if load8(fusedPin14, 0) != next14 { store8(fusedPin14, 0, next14); }
      }
      if load8(fusedPinDirty, 15) == 1 {
        store8(fusedPinDirty, 15, 0);
        const next15 = fusedNet17();
        if load8(fusedPin15, 0) != next15 { store8(fusedPin15, 0, next15); }
      }
    }
    if load8(fusedDirtyGroups, 2) == 1 {
      store8(fusedDirtyGroups, 2, 0);
      if load8(fusedPinDirty, 16) == 1 {
        store8(fusedPinDirty, 16, 0);
        const next16 = fusedNet18();
        if load8(fusedPin16, 0) != next16 { store8(fusedPin16, 0, next16); }
      }
      if load8(fusedPinDirty, 17) == 1 {
        store8(fusedPinDirty, 17, 0);
        const next17 = fusedNet19();
        if load8(fusedPin17, 0) != next17 { store8(fusedPin17, 0, next17); }
      }
      if load8(fusedPinDirty, 18) == 1 {
        store8(fusedPinDirty, 18, 0);
        const next18 = fusedNet20();
        if load8(fusedPin18, 0) != next18 { store8(fusedPin18, 0, next18); }
      }
      if load8(fusedPinDirty, 19) == 1 {
        store8(fusedPinDirty, 19, 0);
        const next19 = fusedNet21();
        if load8(fusedPin19, 0) != next19 { store8(fusedPin19, 0, next19); }
      }
      if load8(fusedPinDirty, 20) == 1 {
        store8(fusedPinDirty, 20, 0);
        const next20 = fusedNet22();
        if load8(fusedPin20, 0) != next20 { store8(fusedPin20, 0, next20); }
      }
      if load8(fusedPinDirty, 21) == 1 {
        store8(fusedPinDirty, 21, 0);
        const next21 = fusedNet23();
        if load8(fusedPin21, 0) != next21 { store8(fusedPin21, 0, next21); }
      }
      if load8(fusedPinDirty, 22) == 1 {
        store8(fusedPinDirty, 22, 0);
        const next22 = fusedNet24();
        if load8(fusedPin22, 0) != next22 { store8(fusedPin22, 0, next22); }
      }
      if load8(fusedPinDirty, 23) == 1 {
        store8(fusedPinDirty, 23, 0);
        const next23 = fusedNet25();
        if load8(fusedPin23, 0) != next23 { store8(fusedPin23, 0, next23); }
      }
    }
    if load8(fusedDirtyGroups, 3) == 1 {
      store8(fusedDirtyGroups, 3, 0);
      if load8(fusedPinDirty, 24) == 1 {
        store8(fusedPinDirty, 24, 0);
        const next24 = fusedNet26();
        if load8(fusedPin24, 0) != next24 { store8(fusedPin24, 0, next24); }
      }
      if load8(fusedPinDirty, 25) == 1 {
        store8(fusedPinDirty, 25, 0);
        const next25 = fusedNet27();
        if load8(fusedPin25, 0) != next25 { store8(fusedPin25, 0, next25); }
      }
      if load8(fusedPinDirty, 26) == 1 {
        store8(fusedPinDirty, 26, 0);
        const next26 = fusedNet28();
        if load8(fusedPin26, 0) != next26 { store8(fusedPin26, 0, next26); }
      }
      if load8(fusedPinDirty, 27) == 1 {
        store8(fusedPinDirty, 27, 0);
        const next27 = fusedNet29();
        if load8(fusedPin27, 0) != next27 { store8(fusedPin27, 0, next27); }
      }
      if load8(fusedPinDirty, 28) == 1 {
        store8(fusedPinDirty, 28, 0);
        const next28 = fusedNet30();
        if load8(fusedPin28, 0) != next28 { store8(fusedPin28, 0, next28); }
      }
      if load8(fusedPinDirty, 29) == 1 {
        store8(fusedPinDirty, 29, 0);
        const next29 = fusedNet31();
        if load8(fusedPin29, 0) != next29 { store8(fusedPin29, 0, next29); }
      }
      if load8(fusedPinDirty, 30) == 1 {
        store8(fusedPinDirty, 30, 0);
        const next30 = fusedNet32();
        if load8(fusedPin30, 0) != next30 { store8(fusedPin30, 0, next30); }
      }
      if load8(fusedPinDirty, 31) == 1 {
        store8(fusedPinDirty, 31, 0);
        const next31 = fusedNet33();
        if load8(fusedPin31, 0) != next31 { store8(fusedPin31, 0, next31); }
      }
    }
    if load8(fusedDirtyGroups, 4) == 1 {
      store8(fusedDirtyGroups, 4, 0);
      if load8(fusedPinDirty, 32) == 1 {
        store8(fusedPinDirty, 32, 0);
        const next32 = fusedNet34();
        if load8(fusedPin32, 0) != next32 { store8(fusedPin32, 0, next32); }
      }
      if load8(fusedPinDirty, 33) == 1 {
        store8(fusedPinDirty, 33, 0);
        const next33 = fusedNet35();
        if load8(fusedPin33, 0) != next33 { store8(fusedPin33, 0, next33); }
      }
      if load8(fusedPinDirty, 34) == 1 {
        store8(fusedPinDirty, 34, 0);
        const next34 = fusedNet36();
        if load8(fusedPin34, 0) != next34 { store8(fusedPin34, 0, next34); }
      }
      if load8(fusedPinDirty, 35) == 1 {
        store8(fusedPinDirty, 35, 0);
        const next35 = fusedNet37();
        if load8(fusedPin35, 0) != next35 { store8(fusedPin35, 0, next35); }
      }
      if load8(fusedPinDirty, 36) == 1 {
        store8(fusedPinDirty, 36, 0);
        const next36 = fusedNet38();
        if load8(fusedPin36, 0) != next36 { store8(fusedPin36, 0, next36); }
      }
      if load8(fusedPinDirty, 37) == 1 {
        store8(fusedPinDirty, 37, 0);
        const next37 = fusedNet39();
        if load8(fusedPin37, 0) != next37 { store8(fusedPin37, 0, next37); }
      }
      if load8(fusedPinDirty, 38) == 1 {
        store8(fusedPinDirty, 38, 0);
        const next38 = fusedNet40();
        if load8(fusedPin38, 0) != next38 { store8(fusedPin38, 0, next38); }
      }
      if load8(fusedPinDirty, 39) == 1 {
        store8(fusedPinDirty, 39, 0);
        const next39 = fusedNet41();
        if load8(fusedPin39, 0) != next39 { store8(fusedPin39, 0, next39); }
      }
    }
  }

  /** Full power-up mirror initialization; clears marks left by the initial button diff. */
  fn fusedRefreshAllBody() {
    const next0 = fusedNet2();
    if load8(fusedPin0, 0) != next0 { store8(fusedPin0, 0, next0); }
    const next1 = fusedNet3();
    if load8(fusedPin1, 0) != next1 { store8(fusedPin1, 0, next1); }
    const next2 = fusedNet4();
    if load8(fusedPin2, 0) != next2 { store8(fusedPin2, 0, next2); }
    const next3 = fusedNet5();
    if load8(fusedPin3, 0) != next3 { store8(fusedPin3, 0, next3); }
    const next4 = fusedNet6();
    if load8(fusedPin4, 0) != next4 { store8(fusedPin4, 0, next4); }
    const next5 = fusedNet7();
    if load8(fusedPin5, 0) != next5 { store8(fusedPin5, 0, next5); }
    const next6 = fusedNet8();
    if load8(fusedPin6, 0) != next6 { store8(fusedPin6, 0, next6); }
    const next7 = fusedNet9();
    if load8(fusedPin7, 0) != next7 { store8(fusedPin7, 0, next7); }
    const next8 = fusedNet10();
    if load8(fusedPin8, 0) != next8 { store8(fusedPin8, 0, next8); }
    const next9 = fusedNet11();
    if load8(fusedPin9, 0) != next9 { store8(fusedPin9, 0, next9); }
    const next10 = fusedNet12();
    if load8(fusedPin10, 0) != next10 { store8(fusedPin10, 0, next10); }
    const next11 = fusedNet13();
    if load8(fusedPin11, 0) != next11 { store8(fusedPin11, 0, next11); }
    const next12 = fusedNet14();
    if load8(fusedPin12, 0) != next12 { store8(fusedPin12, 0, next12); }
    const next13 = fusedNet15();
    if load8(fusedPin13, 0) != next13 { store8(fusedPin13, 0, next13); }
    const next14 = fusedNet16();
    if load8(fusedPin14, 0) != next14 { store8(fusedPin14, 0, next14); }
    const next15 = fusedNet17();
    if load8(fusedPin15, 0) != next15 { store8(fusedPin15, 0, next15); }
    const next16 = fusedNet18();
    if load8(fusedPin16, 0) != next16 { store8(fusedPin16, 0, next16); }
    const next17 = fusedNet19();
    if load8(fusedPin17, 0) != next17 { store8(fusedPin17, 0, next17); }
    const next18 = fusedNet20();
    if load8(fusedPin18, 0) != next18 { store8(fusedPin18, 0, next18); }
    const next19 = fusedNet21();
    if load8(fusedPin19, 0) != next19 { store8(fusedPin19, 0, next19); }
    const next20 = fusedNet22();
    if load8(fusedPin20, 0) != next20 { store8(fusedPin20, 0, next20); }
    const next21 = fusedNet23();
    if load8(fusedPin21, 0) != next21 { store8(fusedPin21, 0, next21); }
    const next22 = fusedNet24();
    if load8(fusedPin22, 0) != next22 { store8(fusedPin22, 0, next22); }
    const next23 = fusedNet25();
    if load8(fusedPin23, 0) != next23 { store8(fusedPin23, 0, next23); }
    const next24 = fusedNet26();
    if load8(fusedPin24, 0) != next24 { store8(fusedPin24, 0, next24); }
    const next25 = fusedNet27();
