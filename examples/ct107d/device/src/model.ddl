  /** LE 下降沿：锁存此刻的字节。 */
  reaction u8_latchEdge on fusedWire49 as (previous, current) {
    if previous == Logic.high && current != Logic.high {
      const value = u8_inputs;
      u8_stored = value;
      u8_latch.send(value);
      u8_publishAll();
    }
  }

  /** OE# 变化只影响输出使能。 */
  reaction u8_enableChanged on fusedWire1 as (previous, current) {
    u8_publishAll();
  }


  assert 25 >= 0.001 && 25 <= 1_000_000_000,
    "25 must be within the supported range";
  assert isFinite(0.8) && 0.8 >= 0,
    "0.8 must be finite and non-negative";
  assert isFinite(2) && 2 > 0.8,
    "2 must be finite and greater than 0.8";


  output channel u9_latch: number(capacity: 8, overflow: Overflow.drop_oldest);

  /** 最近一次锁存的字节，与 Q 是否被 OE# 释放无关。 */
  state u9_stored: number = 0;

  pure fn u9_bit(level: Logic) -> number {
    if level == Logic.high {
      return 1;
    }
    return 0;
  }

  pure fn u9_dataByte() -> number {
    return u9_bit(fusedWire2)
      + u9_bit(fusedWire3) * 2
      + u9_bit(fusedWire4) * 4
      + u9_bit(fusedWire5) * 8
      + u9_bit(fusedWire6) * 16
      + u9_bit(fusedWire7) * 32
      + u9_bit(fusedWire8) * 64
      + u9_bit(fusedWire9) * 128;
  }

  derived u9_transparent: bool = fusedWire48 == Logic.high;
  derived u9_outputsEnabled: bool = fusedWire1 == Logic.low;
  derived u9_inputs: number = u9_dataByte();

  /**
   * 透明阶段的观察源：LE 为高时记录当刻 D 字节；LE 为低时记录固定占位值 0。
   *
   * 非透明阶段的 value 不读取 D，因此 D 变化不会改变记录；这既避免重算 dataByte，
   * 也不会唤醒 follow。静态订阅仍覆盖两个分支的依赖，D 发布只会触发一次求值。
   */
  record u9_FollowState {
    transparent: bool;
    value: number;
  }

  derived u9_followState: u9_FollowState = u9_transparent
    ? { transparent: true, value: u9_dataByte() }
    : { transparent: false, value: 0 };

  fn u9_driveBit(index: number, level: number) {
    if !u9_outputsEnabled {
      match index {
        0 => { u9_q0_setDrive(4); }
        1 => { u9_q1_setDrive(4); }
        2 => { u9_q2_setDrive(4); }
        3 => { u9_q3_setDrive(4); }
        4 => { u9_q4_setDrive(4); }
        5 => { u9_q5_setDrive(4); }
        6 => { u9_q6_setDrive(4); }
        _ => { u9_q7_setDrive(4); }
      }
    } else if level == 1 {
      match index {
        0 => { u9_q0_setDrive(1); }
        1 => { u9_q1_setDrive(1); }
        2 => { u9_q2_setDrive(1); }
        3 => { u9_q3_setDrive(1); }
        4 => { u9_q4_setDrive(1); }
        5 => { u9_q5_setDrive(1); }
        6 => { u9_q6_setDrive(1); }
        _ => { u9_q7_setDrive(1); }
      }
    } else {
      match index {
        0 => { u9_q0_setDrive(0); }
        1 => { u9_q1_setDrive(0); }
        2 => { u9_q2_setDrive(0); }
        3 => { u9_q3_setDrive(0); }
        4 => { u9_q4_setDrive(0); }
        5 => { u9_q5_setDrive(0); }
        6 => { u9_q6_setDrive(0); }
        _ => { u9_q7_setDrive(0); }
      }
    }
  }

  fn u9_publishAll() {
    u9_driveBit(0, (u9_stored >> 0) & 1);
    u9_driveBit(1, (u9_stored >> 1) & 1);
    u9_driveBit(2, (u9_stored >> 2) & 1);
    u9_driveBit(3, (u9_stored >> 3) & 1);
    u9_driveBit(4, (u9_stored >> 4) & 1);
    u9_driveBit(5, (u9_stored >> 5) & 1);
    u9_driveBit(6, (u9_stored >> 6) & 1);
    u9_driveBit(7, (u9_stored >> 7) & 1);
  }

  process u9_start on u9_started {
    // 573 只在 LE 为高时透明跟随 D。上电时 LE 已低的口不应伪造一次「锁存」；
    // 保持 stored=0 的确定性初始值，等第一个透明相位或下降沿再更新。latch 仍发布
    // 这个确定初始值，便于观察端不需要区分「尚未发布」与「锁存为 0」。
    if fusedWire48 == Logic.high {
      const current = u9_inputs;
      u9_stored = current;
    }
    u9_latch.send(u9_stored);
    u9_publishAll();
  }

  /** 透明阶段：LE 为高时 D 的任意变化直接传到 Q。 */
  process u9_follow on u9_followState {
    if !u9_followState.transparent {
      return;
    }
    const current = u9_followState.value;
    u9_stored = current;
    u9_latch.send(current);
    u9_publishAll();
  }

  /** LE 下降沿：锁存此刻的字节。 */
  reaction u9_latchEdge on fusedWire48 as (previous, current) {
    if previous == Logic.high && current != Logic.high {
      const value = u9_inputs;
      u9_stored = value;
      u9_latch.send(value);
      u9_publishAll();
    }
  }

  /** OE# 变化只影响输出使能。 */
  reaction u9_enableChanged on fusedWire1 as (previous, current) {
    u9_publishAll();
  }


  assert 25 >= 0.001 && 25 <= 1_000_000_000,
    "25 must be within the supported range";
  assert isFinite(0.8) && 0.8 >= 0,
    "0.8 must be finite and non-negative";
  assert isFinite(2) && 2 > 0.8,
    "2 must be finite and greater than 0.8";

  /** 感性负载续流公共端：只声明为被动引脚，不驱动、不模拟钳位二极管。 */

  output channel u10_mask: number(capacity: 8, overflow: Overflow.drop_oldest);
  output channel u10_channels: bytes(maxLength: 7, capacity: 8, overflow: Overflow.drop_oldest);

  pure fn u10_isHigh(level: Logic) -> bool {
    return level == Logic.high;
  }

  pure fn u10_composeMask() -> number {
    return (u10_isHigh(fusedWire77) ? 1 : 0)
      | (u10_isHigh(fusedWire78) ? 2 : 0)
      | (u10_isHigh(fusedWire79) ? 4 : 0)
      | (u10_isHigh(fusedWire80) ? 8 : 0)
      | (u10_isHigh(fusedWire81) ? 16 : 0)
      | (u10_isHigh(fusedWire82) ? 32 : 0)
      | (u10_isHigh(fusedWire83) ? 64 : 0);
  }

  pure fn u10_statusOf(value: number) -> bytes {
    return bytes[
      (value & 1) == 1 ? 0x31 : 0x30,
      (value & 2) == 2 ? 0x31 : 0x30,
      (value & 4) == 4 ? 0x31 : 0x30,
      (value & 8) == 8 ? 0x31 : 0x30,
      (value & 16) == 16 ? 0x31 : 0x30,
      (value & 32) == 32 ? 0x31 : 0x30,
      (value & 64) == 64 ? 0x31 : 0x30
    ];
  }

  fn u10_sink(index: number, active: bool) {
    if active {
      match index {
        1 => { u10_out1_setDrive(0); }
        2 => { u10_out2_setDrive(0); }
        3 => { u10_out3_setDrive(0); }
        4 => { u10_out4_setDrive(0); }
        5 => { u10_out5_setDrive(0); }
        6 => { u10_out6_setDrive(0); }
        7 => { u10_out7_setDrive(0); }
        _ => { }
      }
    } else {
      match index {
        1 => { u10_out1_setDrive(4); }
        2 => { u10_out2_setDrive(4); }
        3 => { u10_out3_setDrive(4); }
        4 => { u10_out4_setDrive(4); }
        5 => { u10_out5_setDrive(4); }
        6 => { u10_out6_setDrive(4); }
        7 => { u10_out7_setDrive(4); }
        _ => { }
      }
    }
  }

  fn u10_applyMask(value: number) {
    u10_sink(1, (value & 1) == 1);
    u10_sink(2, (value & 2) == 2);
    u10_sink(3, (value & 4) == 4);
    u10_sink(4, (value & 8) == 8);
    u10_sink(5, (value & 16) == 16);
    u10_sink(6, (value & 32) == 32);
    u10_sink(7, (value & 64) == 64);
  }

  derived u10_channelMask: number = u10_composeMask();

  process u10_start on u10_started {
    u10_applyMask(u10_channelMask);
    u10_mask.send(u10_channelMask);
    u10_channels.send(u10_statusOf(u10_channelMask));
  }

  process u10_changed on u10_channelMask {
    u10_applyMask(u10_channelMask);
    u10_mask.send(u10_channelMask);
    u10_channels.send(u10_statusOf(u10_channelMask));
  }


  const u11_maxTime = 7_200_000_000_000_000;
  const u11_detectDelay = 100_000_000; // 100 µs 载波存在确认
  const u11_releaseDelay = 150_000_000; // 150 µs 载波消失确认

  assert isFinite(38) && 38 >= 30 && 38 <= 60,
    "38 must be within the 30..60 kHz band of the part";
  assert 25 >= 0.001 && 25 <= 1_000_000_000,
    "25 must be within the supported range";


  input channel u11_carrier: bool(capacity: 8, overflow: Overflow.error);
  output channel u11_receiving: bool(capacity: 8, overflow: Overflow.drop_oldest);

  /** 最近一次接受的载波电平。 */
  state u11_carrierOn: bool = false;
  /** 解调状态：true 表示 OUT 已被拉低。 */
  state u11_detected: bool = false;
  state u11_detectArmed: bool = false;
  state u11_detectDeadline: number = 0;
  state u11_releaseArmed: bool = false;
  state u11_releaseDeadline: number = 0;

  fn u11_pullLow() {
    u11_detected = true;
    u11_out_setDrive(0);
    u11_receiving.send(true);
  }

  fn u11_releaseOutput() {
    u11_detected = false;
    u11_out_setDrive(4);
    u11_receiving.send(false);
  }

  process u11_start on u11_started {
    u11_out_setDrive(4);
    u11_receiving.send(false);
    // 启动过程同时是该通道的唯一消费者。
    loop {
      const level = await u11_carrier.receive();
      if level != u11_carrierOn {
        u11_carrierOn = level;
        if level {
          // 翻转先取消相反相位的挂起定时，再按当前时刻起算。
          u11_releaseArmed = false;
          const next = now() + u11_detectDelay;
          assert isSafeInteger(next) && next <= u11_maxTime,
            "the detect deadline exceeds the supported time range";
          u11_detectDeadline = next;
          u11_detectArmed = true;
        } else {
          u11_detectArmed = false;
          const next = now() + u11_releaseDelay;
          assert isSafeInteger(next) && next <= u11_maxTime,
            "the release deadline exceeds the supported time range";
          u11_releaseDeadline = next;
          u11_releaseArmed = true;
        }
      }
    }
  }

  process u11_detectTimer on u11_detectArmed {
    if !u11_detectArmed {
      return;
    }
    loop {
      // 挂起期间可能已被输入翻转取消：醒来复查后直接结束。
      if !u11_detectArmed {
        return;
      }
      const remaining = u11_detectDeadline - now();
      if remaining <= 0 {
        u11_detectArmed = false;
        if !u11_detected {
          u11_pullLow();
        }
        return;
      }
      await ticks(remaining);
    }
  }

  process u11_releaseTimer on u11_releaseArmed {
    if !u11_releaseArmed {
      return;
    }
    loop {
      if !u11_releaseArmed {
        return;
      }
      const remaining = u11_releaseDeadline - now();
      if remaining <= 0 {
        u11_releaseArmed = false;
        if u11_detected {
          u11_releaseOutput();
        }
        return;
      }
      await ticks(remaining);
    }
  }


  assert 25 >= 0.001 && 25 <= 1_000_000_000,
    "25 must be within the supported range";
  assert 20 == 20 || 20 == 200, "20 must be 20 or 200";
  assert isFinite(0.8) && 0.8 >= 0,
    "0.8 must be finite and non-negative";
  assert isFinite(2) && 2 > 0.8,
    "2 must be finite and greater than 0.8";

  /** GAIN1/GAIN8/BYPASS 只声明为被动引脚，增益与旁路网络不参与数字行为。 */

  output channel u14_active: bool(capacity: 8, overflow: Overflow.drop_oldest);

  pure fn u14_isHigh(level: Logic) -> bool {
    return level == Logic.high;
  }

  derived u14_outHigh: bool = u14_isHigh(fusedWire84) && !u14_isHigh(fusedWire1);

  fn u14_driveOut(high: bool) {
    if high {
      u14_out_setDrive(1);
    } else {
      u14_out_setDrive(0);
    }
  }

  process u14_start on u14_started {
    u14_driveOut(u14_outHigh);
    u14_active.send(u14_outHigh);
  }

  process u14_changed on u14_outHigh {
    u14_driveOut(u14_outHigh);
    u14_active.send(u14_outHigh);
  }


  const u15_maxTime = 7_200_000_000_000_000;
  // 事件期限必须是整数皮秒，因此两个半周期在创建期各取整一次。
  const u15_initialHigh = round(0.693 * (10000 + 10000) * 1e-8 * 1e12);
  const u15_initialLow = round(0.693 * 10000 * 1e-8 * 1e12);

  assert isFinite(10000) && 10000 >= 1, "10000 must be a finite resistance of at least 1 ohm";
  assert isFinite(10000) && 10000 >= 1, "10000 must be a finite resistance of at least 1 ohm";
  assert isFinite(1e-8) && 1e-8 >= 1e-12, "1e-8 must be a finite capacitance of at least 1 pF";
  assert isSafeInteger(u15_initialHigh) && u15_initialHigh > 0,
    "the charging half period must be a positive integer picosecond duration";
  assert isSafeInteger(u15_initialLow) && u15_initialLow > 0,
    "the discharging half period must be a positive integer picosecond duration";
  assert u15_initialHigh + u15_initialLow <= u15_maxTime, "the oscillation period exceeds the supported time range";
  assert 25 >= 0.001 && 25 <= 1_000_000_000,
    "25 must be within the supported range";


  input channel u15_timingScale: number(capacity: 8, overflow: Overflow.drop_oldest);
  output channel u15_frequency: number(capacity: 4, overflow: Overflow.drop_oldest);
  output channel u15_dutyCycle: number(capacity: 4, overflow: Overflow.drop_oldest);

  state u15_tHigh: number = u15_initialHigh;
  state u15_tLow: number = u15_initialLow;
  state u15_timingStarted: bool = false;
  /** 是否在振荡；RST# 低电平时为 false。 */
  state u15_running: bool = false;
  /** 当前相位：true 为高相（充电、OUT 高、DISCH 释放），false 为低相。 */
  state u15_high: bool = false;
  /** 当前相位结束的绝对时刻。 */
  state u15_deadline: number = 0;

  fn u15_drivePhase() {
    if !u15_running {
      // 停振：OUT 与开漏的 DISCH 都拉低。
      u15_out_setDrive(0);
      u15_disch_setDrive(0);
    } else if u15_high {
      u15_out_setDrive(1);
      u15_disch_setDrive(4);
    } else {
      u15_out_setDrive(0);
      u15_disch_setDrive(0);
    }
  }

  fn u15_stopOscillation() {
    u15_running = false;
    u15_high = false;
    u15_drivePhase();
  }

  fn u15_startCharging() {
    const next = now() + u15_tHigh;
    assert isSafeInteger(next) && next <= u15_maxTime,
      "the phase deadline exceeds the supported time range";
    u15_running = true;
    u15_high = true;
    u15_deadline = next;
    u15_drivePhase();
  }

  reaction u15_resetChanged on fusedWire0 as (previous, current) {
    const wasHigh = previous == Logic.high;
    const isHigh = current == Logic.high;
    if wasHigh && !isHigh {
      u15_stopOscillation();
    } else if !wasHigh && isHigh {
      u15_startCharging();
    }
  }

  fn u15_publishTiming() {
    u15_frequency.send(1e12 / (u15_tHigh + u15_tLow));
    u15_dutyCycle.send(u15_tHigh / (u15_tHigh + u15_tLow) * 100);
  }

  fn u15_updateTiming(scale: number) {
    const resistance = 10000 * scale;
    if !isFinite(resistance) || resistance < 1 { return; }
    const nextHigh = round(0.693 * (10000 + resistance) * 1e-8 * 1e12);
    const nextLow = round(0.693 * resistance * 1e-8 * 1e12);
    if !isSafeInteger(nextHigh) || !isSafeInteger(nextLow) || nextHigh <= 0 ||
        nextLow <= 0 || nextHigh + nextLow > u15_maxTime { return; }
    if u15_tHigh == nextHigh && u15_tLow == nextLow { return; }
    // 不改已安排的边沿；下一相使用新时长，避免拖动时截断当前脉冲。
    u15_tHigh = nextHigh;
    u15_tLow = nextLow;
    u15_publishTiming();
  }

  process u15_consumeTiming on u15_timingStarted {
    loop {
      const scale = await u15_timingScale.receive();
      u15_updateTiming(scale);
    }
  }

  process u15_start on u15_started {
    u15_timingStarted = true;
    // 未知电平按低处理：只有确定为高才起振。
    if fusedWire0 == Logic.high {
      u15_startCharging();
    } else {
      u15_stopOscillation();
    }
    u15_publishTiming();
  }

  process u15_oscillate on u15_running {
    if !u15_running {
      return;
    }
    loop {
      // RST# 在等待期间可能已经停振：醒来先复查，不驱动任何引脚。
      if !u15_running {
        return;
      }
      const remaining = u15_deadline - now();
      if remaining <= 0 {
        u15_high = !u15_high;
        const next = now() + (u15_high ? u15_tHigh : u15_tLow);
        assert isSafeInteger(next) && next <= u15_maxTime,
          "the phase deadline exceeds the supported time range";
        u15_deadline = next;
        u15_drivePhase();
      }
      await ticks(u15_deadline - now());
    }
  }


  assert 25 >= 0.001 && 25 <= 1_000_000_000,
    "25 must be within the supported range";
  assert 0.8 >= 0 && 0.8 <= 5,
    "0.8 must be within 0..5 V";
  assert 2 > 0.8 && 2 <= 5,
    "2 must be above 0.8 and within 5 V";

  // 模拟引脚不在电气域建模；真实名称由 device.json 的 label 保留。

  // Each input is a voltage level; a newer pending update supersedes the older one.
  input channel u16_ain0: number(capacity: 1, overflow: Overflow.drop_oldest);
  input channel u16_ain1: number(capacity: 1, overflow: Overflow.drop_oldest);
  input channel u16_ain2: number(capacity: 1, overflow: Overflow.drop_oldest);
  input channel u16_ain3: number(capacity: 1, overflow: Overflow.drop_oldest);

  output channel u16_aout: number(capacity: 16, overflow: Overflow.drop_oldest);
  output channel u16_channel: number(capacity: 16, overflow: Overflow.drop_oldest);

  enum u16_Phase {
    idle,
    receiveAddress,
    receiveControl,
    receiveData,
    acknowledge,
    transmit,
    masterAck,
    ignore
  }

  record u16_BusCodes {
    clockCode: number;
    dataCode: number;
  }

  state u16_phase: u16_Phase = u16_Phase.idle;
  state u16_receiveShift: number = 0;
  state u16_receiveBits: number = 0;
  state u16_addressLow: number = 0;
  state u16_controlByte: number = 0;
  state u16_channelIndex: number = 0;
  state u16_dacLevel: number = 0;
  state u16_nextPhase: u16_Phase = u16_Phase.idle;
  state u16_transmitByte: number = 0;
  state u16_transmitBits: number = 0;
  state u16_masterAck: bool = false;
  state u16_masterAckSampled: bool = false;
  state u16_sinking: bool = false;
  state u16_analog0: number = 0;
  state u16_analog1: number = 0;
  state u16_analog2: number = 0;
  state u16_analog3: number = 0;
  /** 四个接收过程共用的启动信号；process start 置真后各过程常驻等待自己的通道。 */
  state u16_sampling: bool = false;

  /** 未知电平按低处理：只有 Logic.high 记作 1。 */
  pure fn u16_sampleBit(level: Logic) -> number {
    if level == Logic.high {
      return 1;
    }
    return 0;
  }

  /** 总线编码保留未知：高=1、低=0、未知=2。 */
  pure fn u16_busCode(level: Logic) -> number {
    if level == Logic.high {
      return 1;
    } else if level == Logic.low {
      return 0;
    }
    return 2;
  }

  pure fn u16_clampedInput(value: number) -> number {
    if isNaN(value) || value < 0 {
      return 0;
    } else if value > 1 {
      return 1;
    }
    return value;
  }

  derived u16_busCodes: u16_BusCodes = {
    clockCode: u16_busCode(fusedWire18),
    dataCode: u16_busCode(fusedWire19)
  };

  fn u16_sink(enabled: bool) {
    u16_sinking = enabled;
    if u16_sinking {
      u16_sda_setDrive(0);
    } else {
      u16_sda_setDrive(4);
    }
  }

  fn u16_acknowledge(next: u16_Phase) {
    u16_nextPhase = next;
    u16_sink(true);
    u16_phase = u16_Phase.acknowledge;
  }

  fn u16_selectedAnalog() -> number {
    if u16_channelIndex == 0 {
      return u16_analog0;
    } else if u16_channelIndex == 1 {
      return u16_analog1;
    } else if u16_channelIndex == 2 {
      return u16_analog2;
    }
    return u16_analog3;
  }

  fn u16_convertedByte() -> number {
    return round(u16_clampedInput(u16_selectedAnalog()) * 255);
  }

  fn u16_writeControl(byte: number) {
    u16_controlByte = byte;
    const selected = byte & 3;
    if selected != u16_channelIndex {
      u16_channelIndex = selected;
      u16_channel.send(u16_channelIndex);
    }
  }

  fn u16_writeDac(byte: number) {
    // DAC 使能位不门控寄存器更新，和旧模型一致。
    if u16_dacLevel != byte {
      u16_dacLevel = byte;
      u16_aout.send(u16_dacLevel / 255);
    }
  }

  fn u16_placeTransmitBit() {
    if u16_transmitBits < 8 {
      const position = 7 - u16_transmitBits;
      const bit = (u16_transmitByte >> position) & 1;
      u16_sink(bit == 0);
      u16_transmitBits = u16_transmitBits + 1;
    } else {
      // 8 位发完，释放 SDA 让主机驱动第 9 个时钟的 ACK/NACK。
      u16_sink(false);
      u16_phase = u16_Phase.masterAck;
      u16_masterAckSampled = false;
    }
  }

  fn u16_beginTransmit() {
    u16_transmitByte = u16_convertedByte();
    u16_transmitBits = 0;
    u16_phase = u16_Phase.transmit;
    if (u16_controlByte & 4) != 0 {
      u16_channelIndex = (u16_channelIndex + 1) & 3;
      u16_channel.send(u16_channelIndex);
    }
    u16_placeTransmitBit();
  }

  fn u16_finishReceivedByte() {
    const byte = u16_receiveShift;
    u16_receiveShift = 0;
    u16_receiveBits = 0;

    if u16_phase == u16_Phase.receiveAddress {
      const matches = (byte & 240) == 144 && ((byte >> 1) & 7) == u16_addressLow;
      if matches {
        if (byte & 1) == 1 {
          u16_acknowledge(u16_Phase.transmit);
        } else {
          u16_acknowledge(u16_Phase.receiveControl);
        }
      } else {
        u16_phase = u16_Phase.ignore;
        u16_sink(false);
      }
    } else if u16_phase == u16_Phase.receiveControl {
      u16_writeControl(byte);
      u16_acknowledge(u16_Phase.receiveData);
    } else if u16_phase == u16_Phase.receiveData {
      u16_writeDac(byte);
      u16_acknowledge(u16_Phase.receiveData);
    }
  }

  process u16_capture0 on u16_sampling {
    loop {
      const raw = await u16_ain0.receive();
      u16_analog0 = u16_clampedInput(raw);
    }
  }

  process u16_capture1 on u16_sampling {
    loop {
      const raw = await u16_ain1.receive();
      u16_analog1 = u16_clampedInput(raw);
    }
  }

  process u16_capture2 on u16_sampling {
    loop {
      const raw = await u16_ain2.receive();
      u16_analog2 = u16_clampedInput(raw);
    }
  }

  process u16_capture3 on u16_sampling {
    loop {
      const raw = await u16_ain3.receive();
      u16_analog3 = u16_clampedInput(raw);
    }
  }

  process u16_start on u16_started {
    u16_sink(false);
    // 先置启动信号，让四个接收过程在首个推进中就绪并常驻等待。
    u16_sampling = true;
    u16_aout.send(u16_dacLevel / 255);
    u16_channel.send(u16_channelIndex);
  }

  reaction u16_busEdge on u16_busCodes as (previous, current)
    capture dataLevel = fusedWire19,
      addressA0 = fusedWire1,
      addressA1 = fusedWire1,
      addressA2 = fusedWire1 {
    const clockHigh = current.clockCode == 1;
    const clockWasHigh = previous.clockCode == 1;
    const dataHigh = current.dataCode == 1;
    const dataWasHigh = previous.dataCode == 1;

    if clockWasHigh && clockHigh && dataWasHigh && !dataHigh {
      // START / 重复 START：主机重新掌握 SDA，并在此刻锁存 A2..A0。
      u16_sink(false);
      u16_phase = u16_Phase.receiveAddress;
      u16_receiveShift = 0;
      u16_receiveBits = 0;
      u16_addressLow = u16_sampleBit(addressA2) * 4 +
        u16_sampleBit(addressA1) * 2 +
        u16_sampleBit(addressA0);
    } else if clockWasHigh && clockHigh && !dataWasHigh && dataHigh {
      // STOP：结束当前事务，释放 SDA。
      u16_sink(false);
      u16_phase = u16_Phase.idle;
      u16_receiveShift = 0;
      u16_receiveBits = 0;
    } else if !clockWasHigh && clockHigh {
      // SCL 上升沿：接收阶段采样主机数据位，主机 ACK 阶段采样 ACK/NACK。
      const receiving = u16_phase == u16_Phase.receiveAddress ||
        u16_phase == u16_Phase.receiveControl ||
        u16_phase == u16_Phase.receiveData;
      if receiving && u16_receiveBits < 8 {
        u16_receiveShift = (u16_receiveShift << 1) | u16_sampleBit(dataLevel);
        u16_receiveBits = u16_receiveBits + 1;
      } else if u16_phase == u16_Phase.masterAck && !u16_masterAckSampled {
        // 主机拉低表示 ACK（继续发送）；高电平表示 NACK。未知按低处理。
        u16_masterAck = dataLevel != Logic.high;
        u16_masterAckSampled = true;
      }
    } else if clockWasHigh && !clockHigh {
      // SCL 下降沿：第 8 个下降沿完成接收字节，第 9 个下降沿推进状态机。
      const receiving = u16_phase == u16_Phase.receiveAddress ||
        u16_phase == u16_Phase.receiveControl ||
        u16_phase == u16_Phase.receiveData;
      if receiving && u16_receiveBits == 8 {
        u16_finishReceivedByte();
      } else if u16_phase == u16_Phase.acknowledge {
        u16_sink(false);
        if u16_nextPhase == u16_Phase.transmit {
          u16_beginTransmit();
        } else {
          u16_phase = u16_nextPhase;
          u16_receiveShift = 0;
          u16_receiveBits = 0;
        }
      } else if u16_phase == u16_Phase.transmit {
        u16_placeTransmitBit();
      } else if u16_phase == u16_Phase.masterAck && u16_masterAckSampled {
        if u16_masterAck {
          u16_beginTransmit();
        } else {
          u16_phase = u16_Phase.ignore;
          u16_sink(false);
        }
      }
    }
  }


  assert 25 >= 0.001 && 25 <= 1_000_000_000,
    "25 must be within the supported range";
  assert isFinite(1.5) && 1.5 >= 0,
    "1.5 must be finite and non-negative";
  assert isFinite(2.8) && 2.8 > 1.5,
    "2.8 must be finite and greater than 1.5";


  state u18_inputHigh1: bool = false;
  state u18_inputHigh2: bool = false;
  state u18_inputHigh3: bool = false;
  state u18_inputHigh4: bool = false;
  state u18_inputHigh5: bool = false;
  state u18_inputHigh6: bool = false;

  fn u18_driveY1() {
    if u18_inputHigh1 {
      u18_y1_setDrive(0);
    } else {
      u18_y1_setDrive(1);
    }
  }

  fn u18_driveY2() {
    if u18_inputHigh2 {
      u18_y2_setDrive(0);
    } else {
      u18_y2_setDrive(1);
    }
  }

  fn u18_driveY3() {
    if u18_inputHigh3 {
      u18_y3_setDrive(0);
    } else {
      u18_y3_setDrive(1);
    }
  }

  fn u18_driveY4() {
    if u18_inputHigh4 {
      u18_y4_setDrive(0);
    } else {
      u18_y4_setDrive(1);
    }
  }

  fn u18_driveY5() {
    if u18_inputHigh5 {
      u18_y5_setDrive(0);
    } else {
      u18_y5_setDrive(1);
    }
  }

  fn u18_driveY6() {
    if u18_inputHigh6 {
      u18_y6_setDrive(0);
    } else {
      u18_y6_setDrive(1);
    }
  }

  fn u18_update1() {
    if fusedWire98 == Logic.high {
      u18_inputHigh1 = true;
    } else if fusedWire98 == Logic.low {
      u18_inputHigh1 = false;
    }
    u18_driveY1();
  }

  fn u18_update2() {
    if fusedWire94 == Logic.high {
      u18_inputHigh2 = true;
    } else if fusedWire94 == Logic.low {
      u18_inputHigh2 = false;
    }
    u18_driveY2();
  }

  fn u18_update3() {
    if fusedWire100 == Logic.high {
      u18_inputHigh3 = true;
    } else if fusedWire100 == Logic.low {
      u18_inputHigh3 = false;
    }
    u18_driveY3();
  }

  fn u18_update4() {
    if fusedWire98 == Logic.high {
      u18_inputHigh4 = true;
    } else if fusedWire98 == Logic.low {
      u18_inputHigh4 = false;
    }
    u18_driveY4();
  }

  fn u18_update5() {
    if fusedWire100 == Logic.high {
      u18_inputHigh5 = true;
    } else if fusedWire100 == Logic.low {
      u18_inputHigh5 = false;
    }
    u18_driveY5();
  }

  fn u18_update6() {
    if fusedWire100 == Logic.high {
      u18_inputHigh6 = true;
    } else if fusedWire100 == Logic.low {
      u18_inputHigh6 = false;
    }
    u18_driveY6();
  }

  process u18_start on u18_started {
    u18_update1();
    u18_update2();
    u18_update3();
    u18_update4();
    u18_update5();
    u18_update6();
  }

  process u18_input1 on fusedWire98 {
    u18_update1();
  }

  process u18_input2 on fusedWire94 {
    u18_update2();
  }

  process u18_input3 on fusedWire100 {
    u18_update3();
  }

  process u18_input4 on fusedWire98 {
    u18_update4();
  }

  process u18_input5 on fusedWire100 {
    u18_update5();
  }

  process u18_input6 on fusedWire100 {
    u18_update6();
  }


  const u19_SECOND = 1_000_000_000_000;

  assert 25 >= 0.001 && 25 <= 1_000_000_000,
    "25 must be within the supported range";
  assert 0.8 >= 0 && 0.8 <= 5,
    "0.8 must be within 0..5 V";
  assert 2 > 0.8 && 2 <= 5,
    "2 must be above 0.8 and within 5 V";

  // 晶振引脚纯被动，32.768 kHz 振荡器不建模。

  output channel u19_datetime: bytes(maxLength: 19, capacity: 4, overflow: Overflow.drop_oldest);
  output channel u19_running: bool(capacity: 4, overflow: Overflow.drop_oldest);

  memory u19_clockRegs[8];
  memory u19_ram[31];

  enum u19_Phase {
    idle,
    command,
    write,
    read,
    ignore
  }

  record u19_Bus {
    clockHigh: bool;
    dataHigh: bool;
  }

  record u19_BcdStep {
    value: number;
    carried: bool;
  }

  state u19_phase: u19_Phase = u19_Phase.idle;
  state u19_commandByte: number = 0;
  state u19_commandBits: number = 0;
  state u19_dataByte: number = 0;
  state u19_dataBits: number = 0;
  state u19_writeIndex: number = 0;
  state u19_readIndex: number = 0;
  state u19_writeProtect: bool = false;
  state u19_lastRunning: bool = false;

  derived u19_rstHigh: bool = fusedWire13 == Logic.high;

  /** 命令/读位同时需要 SCLK 与 IO 的同一时刻电平，先汇成扁平记录再比较。 */
  derived u19_bus: u19_Bus = {
    clockHigh: fusedWire17 == Logic.high,
    dataHigh: fusedWire21 == Logic.high
  };

  fn u19_setIo(active: bool) {
    if active {
      u19_io_setDrive(0);
    } else {
      u19_io_setDrive(4);
    }
  }

  pure fn u19_halted() -> bool {
    return load8(u19_clockRegs, 0) >= 128;
  }

  pure fn u19_bcdToBinary(value: number) -> number {
    const low = value % 16;
    const high = floor(value / 16) % 16;
    return high * 10 + low;
  }

  /** 两位 BCD 自增；低位 9 -> 0 时进位，高位到 maxHigh 时整体回零。 */
  pure fn u19_incBcd(value: number, maxHigh: number) -> u19_BcdStep {
    const low = value % 16;
    const high = floor(value / 16) % 16;
    if low == 9 {
      if high == maxHigh {
        return { value: 0, carried: true };
      }
      return { value: (high + 1) * 16, carried: false };
    }
    return { value: high * 16 + low + 1, carried: false };
  }

  pure fn u19_commandAddress() -> number {
    return floor(u19_commandByte / 2) % 32;
  }

  pure fn u19_commandIsRam() -> bool {
    return u19_commandByte % 128 >= 64;
  }

  pure fn u19_commandIsBurst() -> bool {
    return u19_commandAddress() == 31;
  }

  /** 时钟突发第 8 字节是 WP，读回 bit7。 */
  pure fn u19_burstClockValue(index: number) -> number {
    const slot = index % 8;
    if slot < 7 {
      return load8(u19_clockRegs, slot);
    }
    if u19_writeProtect {
      return 128;
    }
    return 0;
  }

  /** 当前读事务在 `index`（字节序号）上的输出字节；单字节读写固定回同一字节。 */
  pure fn u19_streamValue(index: number) -> number {
    if u19_commandIsBurst() {
      if u19_commandIsRam() {
        return load8(u19_ram, index % 31);
      }
      return u19_burstClockValue(index);
    }
    if u19_commandIsRam() {
      return load8(u19_ram, u19_commandAddress() % 31);
    }
    if u19_commandAddress() < 7 {
      return load8(u19_clockRegs, u19_commandAddress());
    }
    if u19_writeProtect {
      return 128;
    }
    return 0;
  }

  /** ASCII `YYYY-MM-DD HH:MM:SS`，按 19 个元素逐字节构造。 */
  pure fn u19_datetimeBytes() -> bytes {
    const year = 2000 + u19_bcdToBinary(load8(u19_clockRegs, 6));
    const month = u19_bcdToBinary(load8(u19_clockRegs, 4));
    const date = u19_bcdToBinary(load8(u19_clockRegs, 3));
    const hour = u19_bcdToBinary(load8(u19_clockRegs, 2));
    const minute = u19_bcdToBinary(load8(u19_clockRegs, 1));
    const second = u19_bcdToBinary(load8(u19_clockRegs, 0) % 128);
    return bytes[
      48 + floor(year / 1000) % 10,
      48 + floor(year / 100) % 10,
      48 + floor(year / 10) % 10,
      48 + year % 10,
      45,
      48 + floor(month / 10) % 10,
      48 + month % 10,
      45,
      48 + floor(date / 10) % 10,
      48 + date % 10,
      32,
      48 + floor(hour / 10) % 10,
      48 + hour % 10,
      58,
      48 + floor(minute / 10) % 10,
      48 + minute % 10,
      58,
      48 + floor(second / 10) % 10,
      48 + second % 10
    ];
  }

  fn u19_publishStatus() {
    u19_datetime.send(u19_datetimeBytes());
    const active = !u19_halted();
    if active != u19_lastRunning {
      u19_lastRunning = active;
      u19_running.send(active);
    }
  }

  fn u19_initializeRegisters() {
    // 上电时刻 2026-01-01 00:00:00，星期四。
    store8(u19_clockRegs, 0, 0x00);
    store8(u19_clockRegs, 1, 0x00);
    store8(u19_clockRegs, 2, 0x00);
    store8(u19_clockRegs, 3, 0x01);
    store8(u19_clockRegs, 4, 0x01);
    store8(u19_clockRegs, 5, 0x04);
    store8(u19_clockRegs, 6, 0x26);
    store8(u19_clockRegs, 7, 0x00);
    let index = 0;
    while index < 31 {
      store8(u19_ram, index, 0);
      index = index + 1;
    }
    u19_writeProtect = false;
    u19_phase = u19_Phase.idle;
    u19_commandByte = 0;
    u19_commandBits = 0;
    u19_dataByte = 0;
    u19_dataBits = 0;
    u19_writeIndex = 0;
    u19_readIndex = 0;
    u19_setIo(false);
  }

  fn u19_latchCommand() {
    u19_commandBits = 0;
    u19_dataBits = 0;
    u19_dataByte = 0;
    u19_writeIndex = 0;
    u19_readIndex = 0;
    if u19_commandByte < 128 {
      u19_phase = u19_Phase.ignore;
      u19_setIo(false);
    } else if u19_commandByte % 2 == 1 {
      u19_phase = u19_Phase.read;
    } else {
      u19_phase = u19_Phase.write;
    }
  }

  fn u19_applyWrite(value: number) {
    if u19_commandIsBurst() {
      if u19_commandIsRam() {
        if !u19_writeProtect {
          store8(u19_ram, u19_writeIndex % 31, value);
        }
      } else if !u19_writeProtect {
        // WP = 1 丢弃整个时钟突发，包括末尾的 WP 字节。
        const slot = u19_writeIndex % 8;
        if slot < 7 {
          store8(u19_clockRegs, slot, value);
          u19_publishStatus();
        } else if value >= 128 {
          u19_writeProtect = true;
        } else {
          u19_writeProtect = false;
        }
      }
      u19_writeIndex = u19_writeIndex + 1;
      return;
    }
    if u19_commandIsRam() {
      if !u19_writeProtect {
        store8(u19_ram, u19_commandAddress() % 31, value);
      }
      return;
    }
    if u19_commandAddress() == 7 {
      // WP 寄存器自身保持可写，主机才能解除保护。
      u19_writeProtect = value >= 128;
      return;
    }
    if u19_writeProtect {
      return;
    }
    if u19_commandAddress() < 7 {
      store8(u19_clockRegs, u19_commandAddress(), value);
      u19_publishStatus();
    }
  }

  /** 1 s 走时：秒 -> 分 -> 时 -> 日 -> 星期 -> 月 -> 年，逐级 BCD 进位。 */
  fn u19_advanceSecond() {
    const secondsReg = load8(u19_clockRegs, 0);
    const secondStep = u19_incBcd(secondsReg % 128, 5);
    if secondsReg >= 128 {
      store8(u19_clockRegs, 0, 128 + secondStep.value);
    } else {
      store8(u19_clockRegs, 0, secondStep.value);
    }
    if !secondStep.carried {
      return;
    }
    const minuteStep = u19_incBcd(load8(u19_clockRegs, 1), 5);
    store8(u19_clockRegs, 1, minuteStep.value);
    if !minuteStep.carried {
      return;
    }
    const hourReg = load8(u19_clockRegs, 2);
    if hourReg == 0x23 {
      store8(u19_clockRegs, 2, 0x00);
    } else {
      store8(u19_clockRegs, 2, u19_incBcd(hourReg, 9).value);
    }
    if hourReg != 0x23 {
      return;
    }
    const dateReg = load8(u19_clockRegs, 3);
    const monthReg = load8(u19_clockRegs, 4);
    const yearReg = load8(u19_clockRegs, 6);
    const month = u19_bcdToBinary(monthReg);
    const year = u19_bcdToBinary(yearReg);
    let days = 31;
    if month == 2 {
      if year % 4 == 0 {
        days = 29;
      } else {
        days = 28;
      }
    } else if month == 4 || month == 6 || month == 9 || month == 11 {
      days = 30;
    }
    const monthCarry = u19_bcdToBinary(dateReg) >= days;
    if monthCarry {
      store8(u19_clockRegs, 3, 0x01);
    } else {
      store8(u19_clockRegs, 3, u19_incBcd(dateReg, 9).value);
    }
    // 星期在每次午夜递增，而不是只在月末。
    const weekdayReg = load8(u19_clockRegs, 5);
    if weekdayReg >= 7 {
      store8(u19_clockRegs, 5, 0x01);
    } else {
      store8(u19_clockRegs, 5, weekdayReg + 1);
    }
    if !monthCarry {
      return;
    }
    if monthReg == 0x12 {
      store8(u19_clockRegs, 4, 0x01);
      if yearReg == 0x99 {
        store8(u19_clockRegs, 6, 0x00);
      } else {
        store8(u19_clockRegs, 6, u19_incBcd(yearReg, 9).value);
      }
    } else {
      store8(u19_clockRegs, 4, u19_incBcd(monthReg, 9).value);
    }
  }

  process u19_start on u19_started {
    u19_initializeRegisters();
    u19_datetime.send(u19_datetimeBytes());
    u19_lastRunning = !u19_halted();
    u19_running.send(u19_lastRunning);
    loop {
      await ticks(u19_SECOND);
      // CH = 1 时停振且不发布，和旧模型一致。
      if !u19_halted() {
        u19_advanceSecond();
        u19_publishStatus();
      }
    }
  }

  reaction u19_resetEdge on u19_rstHigh as (previous, current) {
    if current && !previous {
      u19_phase = u19_Phase.command;
      u19_commandByte = 0;
      u19_commandBits = 0;
      u19_dataByte = 0;
      u19_dataBits = 0;
      u19_writeIndex = 0;
      u19_readIndex = 0;
      u19_setIo(false);
    } else if previous && !current {
      u19_phase = u19_Phase.idle;
      u19_setIo(false);
    }
  }

  reaction u19_busEdge on u19_bus as (previous, current) {
    if !previous.clockHigh && current.clockHigh {
      // SCLK 上升沿：命令字节或写数据位 LSB first 移入。
      if u19_phase == u19_Phase.command {
        u19_commandByte = u19_commandByte + (current.dataHigh ? 1 : 0) * pow(2, u19_commandBits);
        u19_commandBits = u19_commandBits + 1;
        if u19_commandBits == 8 {
          u19_latchCommand();
        }
      } else if u19_phase == u19_Phase.write {
        u19_dataByte = u19_dataByte + (current.dataHigh ? 1 : 0) * pow(2, u19_dataBits);
        u19_dataBits = u19_dataBits + 1;
        if u19_dataBits == 8 {
          const value = u19_dataByte;
          u19_dataByte = 0;
          u19_dataBits = 0;
          u19_applyWrite(value);
        }
      }
    } else if previous.clockHigh && !current.clockHigh {
      // SCLK 下降沿：读事务把下一位放到 IO 上，0 位拉低、1 位释放。
      if u19_phase == u19_Phase.read {
        const byte = u19_streamValue(floor(u19_readIndex / 8));
        const bit = floor(byte / pow(2, u19_readIndex % 8)) % 2;
        u19_readIndex = u19_readIndex + 1;
        u19_setIo(bit == 0);
      }
    }
  }


  const u20_maxTime = 7_200_000_000_000_000;
  const u20_detectDelay = 50_000_000; // 50 µs 载波存在确认
  const u20_releaseDelay = 200_000_000; // 200 µs 载波消失确认

  assert 25 >= 0.001 && 25 <= 1_000_000_000,
    "25 must be within the supported range";


  input channel u20_carrier: bool(capacity: 8, overflow: Overflow.error);
  output channel u20_receiving: bool(capacity: 8, overflow: Overflow.drop_oldest);

  /** 最近一次接受的载波电平。 */
  state u20_carrierOn: bool = false;
  /** 解调状态：true 表示 OUT 已被拉低。 */
  state u20_detected: bool = false;
  state u20_detectArmed: bool = false;
  state u20_detectDeadline: number = 0;
  state u20_releaseArmed: bool = false;
  state u20_releaseDeadline: number = 0;

  fn u20_pullLow() {
    u20_detected = true;
    u20_out_setDrive(0);
    u20_receiving.send(true);
  }

  fn u20_releaseOutput() {
    u20_detected = false;
    u20_out_setDrive(4);
    u20_receiving.send(false);
  }

  process u20_start on u20_started {
    u20_out_setDrive(4);
    u20_receiving.send(false);
    // 启动过程同时是该通道的唯一消费者。
    loop {
      const level = await u20_carrier.receive();
      if level != u20_carrierOn {
        u20_carrierOn = level;
        if level {
          // 翻转先取消相反相位的挂起定时，再按当前时刻起算。
          u20_releaseArmed = false;
          const next = now() + u20_detectDelay;
          assert isSafeInteger(next) && next <= u20_maxTime,
            "the detect deadline exceeds the supported time range";
          u20_detectDeadline = next;
          u20_detectArmed = true;
        } else {
          u20_detectArmed = false;
          const next = now() + u20_releaseDelay;
          assert isSafeInteger(next) && next <= u20_maxTime,
            "the release deadline exceeds the supported time range";
          u20_releaseDeadline = next;
          u20_releaseArmed = true;
        }
      }
    }
  }

  process u20_detectTimer on u20_detectArmed {
    if !u20_detectArmed {
      return;
    }
    loop {
      // 挂起期间可能已被输入翻转取消：醒来复查后直接结束。
      if !u20_detectArmed {
        return;
      }
      const remaining = u20_detectDeadline - now();
      if remaining <= 0 {
        u20_detectArmed = false;
        if !u20_detected {
          u20_pullLow();
        }
        return;
      }
      await ticks(remaining);
    }
  }

  process u20_releaseTimer on u20_releaseArmed {
    if !u20_releaseArmed {
      return;
    }
    loop {
      if !u20_releaseArmed {
        return;
      }
      const remaining = u20_releaseDeadline - now();
      if remaining <= 0 {
        u20_releaseArmed = false;
        if u20_detected {
          u20_releaseOutput();
        }
        return;
      }
      await ticks(remaining);
    }
  }


  const u21_MAX_FIELD = 1000;

  assert isFinite(0) && 0 >= 0 && 0 <= u21_MAX_FIELD,
    "0 must be within 0..1000 mT";
  assert isFinite(15) && 15 >= 0 && 15 <= u21_MAX_FIELD,
    "15 must be within 0..1000 mT";
  assert isFinite(10) && 10 >= 0 && 10 <= u21_MAX_FIELD,
    "10 must be within 0..1000 mT";
  assert 15 > 10,
    "15 must be greater than 10";
  assert 25 >= 0.001 && 25 <= 1_000_000_000,
    "25 must be within the supported range";
  assert 0.8 >= 0 && 0.8 <= 5,
    "0.8 must be within 0..5 V";
  assert 2 > 0.8 && 2 <= 5,
    "2 must be above 0.8 and within 5 V";


  input channel u21_fieldInput: number(capacity: 8, overflow: Overflow.error);
  output channel u21_active: bool(capacity: 8, overflow: Overflow.drop_oldest);

  /** 最近一次接受的磁场，单位 mT。 */
  state u21_fieldMillitesla: number = 0;
  /** 传感器内部的开关锁存；上电后才可能为真。 */
  state u21_latched: bool = false;
  /** 已发布给宿主的吸合状态，用于抑制启动阶段的重复事件。 */
  state u21_reportedActive: bool = false;

  pure fn u21_isHigh(level: Logic) -> bool {
    return level == Logic.high;
  }

  pure fn u21_isLow(level: Logic) -> bool {
    return level == Logic.low;
  }

  /** 只有 VCC 确定拉高且 GND 确定拉低时才认为器件获得供电。 */
  derived u21_powered: bool = u21_isHigh(Logic.high) && u21_isLow(Logic.low);
  /** 对外可见的吸合状态；掉电时强制为假。 */
  derived u21_activeState: bool = u21_powered && u21_latched;

  fn u21_driveOutput(enabled: bool) {
    if enabled {
      u21_out_setDrive(0);
    } else {
      u21_out_setDrive(4);
    }
  }

  /** 迟滞更新：进入吸合区置位，进入释放区复位，中间保持。 */
  fn u21_updateLatch(value: number) {
    if value >= 15 {
      u21_latched = true;
    } else if value <= 10 {
      u21_latched = false;
    }
  }

  /** 上电或重新上电时只按吸合点判定，不把掉电前的锁存带回来。 */
  fn u21_restoreLatch() {
    if u21_fieldMillitesla >= 15 {
      u21_latched = true;
    } else {
      u21_latched = false;
    }
  }

  process u21_start on u21_started {
    if u21_powered {
      u21_restoreLatch();
    } else {
      u21_latched = false;
    }
    u21_driveOutput(u21_activeState);
    u21_reportedActive = u21_activeState;
    u21_active.send(u21_activeState);
    // 启动过程同时是该通道的唯一消费者。
    loop {
      const value = await u21_fieldInput.receive();
      assert isFinite(value) && value >= 0 && value <= u21_MAX_FIELD,
        "0 must be within 0..1000 mT";
      u21_fieldMillitesla = value;
      if u21_powered {
        u21_updateLatch(value);
      }
    }
  }

  /** 供电变化时释放输出；恢复后按当前磁场重新建立锁存。 */
  process u21_power on u21_powered {
    if u21_powered {
      u21_restoreLatch();
    } else {
      u21_latched = false;
    }
  }

  process u21_changed on u21_activeState {
    u21_driveOutput(u21_activeState);
    if u21_reportedActive != u21_activeState {
      u21_reportedActive = u21_activeState;
      u21_active.send(u21_activeState);
    }
  }


  const u22_MICROSECOND = 1_000_000;
  const u22_MAX_TIME = 7_200_000_000_000_000;

  assert isFinite(ultrasonicDistanceCm) && ultrasonicDistanceCm >= 0,
    "ultrasonicDistanceCm must be a finite non-negative distance";
  assert -1 == -1 || (isSafeInteger(-1) && -1 >= 0),
    "-1 must be -1 or a non-negative safe integer number of microseconds";
  assert 25 >= 0.001 && 25 <= 1_000_000_000,
    "25 must be within the supported range";
  assert 0.8 >= 0 && 0.8 <= 5,
    "0.8 must be within 0..5 V";
  assert 2 > 0.8 && 2 <= 5,
    "2 must be above 0.8 and within 5 V";

  // ultrasonicDistanceCm 以厘米注入；340 m/s 换算到厘米需要先除以 100。
  const u22_derivedEchoUs = round(2 * (ultrasonicDistanceCm / 100) / 340 * 1_000_000);
  const u22_effectiveEchoUs = -1 >= 0 ? -1 : u22_derivedEchoUs;
  const u22_ECHO_WIDTH = u22_effectiveEchoUs * u22_MICROSECOND;

  assert isSafeInteger(u22_ECHO_WIDTH) && u22_ECHO_WIDTH >= 0 && u22_ECHO_WIDTH <= u22_MAX_TIME,
    "the calculated echo width exceeds the supported time range";


  /** 已观察到一个明确的低→高边沿，等待同一脉冲的下降沿。 */
  state u22_pulseArmed: bool = false;
  /** 当前请求是否已经建立回波截止；上升沿与未知电平均会清除它。 */
  state u22_echoPending: bool = false;
  /** ECHO 拉低（回波到达）的绝对截止时间。 */
  state u22_echoLowAt: number = 0;
  /** ECHO 恢复空闲高电平的绝对截止时间。 */
  state u22_echoHighAt: number = 0;
  /** 每次撤销或建立请求时递增，用于让旧定时任务失效。 */
  state u22_echoSequence: number = 0;

  fn u22_driveEcho(high: bool) {
    if high {
      u22_echo_setDrive(1);
    } else {
      u22_echo_setDrive(0);
    }
  }

  /** 撤销旧请求并回到空闲高；序号递增使所有旧等待在下次唤醒时退出。 */
  fn u22_cancelEcho() {
    u22_echoPending = false;
    u22_echoSequence = u22_echoSequence + 1;
    u22_driveEcho(true);
  }

  /** 完整脉冲下降沿建立新请求，两个截止都从 F 起算。 */
  fn u22_scheduleEcho() {
    u22_echoLowAt = now() + u22_ECHO_WIDTH;
    u22_echoHighAt = u22_echoLowAt + u22_ECHO_WIDTH;
    assert isSafeInteger(u22_echoLowAt) && u22_echoLowAt <= u22_MAX_TIME,
      "the echo arrival deadline exceeds the supported time range";
    assert isSafeInteger(u22_echoHighAt) && u22_echoHighAt <= u22_MAX_TIME,
      "the echo release deadline exceeds the supported time range";
    u22_echoPending = true;
    u22_echoSequence = u22_echoSequence + 1;
  }

  /**
   * TRIG 逻辑边沿。只有明确的低→高才武装，只有已武装的高→低才完成候选；unknown
   * 与无配对下降都不建立请求。
   */
  reaction u22_trigEdge on fusedWire10 as (previous, current) {
    if current == Logic.unknown {
      u22_pulseArmed = false;
      u22_cancelEcho();
      return;
    }

    if current == Logic.high {
      if previous == Logic.low {
        u22_pulseArmed = true;
        u22_cancelEcho();
      }
      return;
    }

    // current == Logic.low
    if previous == Logic.high && u22_pulseArmed {
      u22_pulseArmed = false;
      u22_scheduleEcho();
    }
  }

  /**
   * ECHO 低电平阶段。旧请求醒来时序号已变化，直接退出；若新的 low 截止更早，旧 high
   * 等待不会占用本过程。D=0 时不驱动低电平，避免制造正宽度伪脉冲。
   */
  process u22_echoLow on u22_echoSequence {
    if !u22_echoPending || u22_ECHO_WIDTH == 0 {
      return;
    }

    const sequence = u22_echoSequence;
    loop {
      if !u22_echoPending || u22_echoSequence != sequence {
        return;
      }
      const remaining = u22_echoLowAt - now();
      if remaining <= 0 {
        u22_driveEcho(false);
        return;
      }
      await ticks(remaining);
    }
  }

  /** ECHO 恢复高电平阶段；与低电平过程独立，彼此不阻塞新请求。 */
  process u22_echoHigh on u22_echoSequence {
    if !u22_echoPending {
      return;
    }

    const sequence = u22_echoSequence;
    loop {
      if !u22_echoPending || u22_echoSequence != sequence {
        return;
      }
      const remaining = u22_echoHighAt - now();
      if remaining <= 0 {
        u22_driveEcho(true);
        return;
      }
      await ticks(remaining);
    }
  }

  process u22_start on u22_started {
    u22_driveEcho(true);
  }


  assert 25 >= 0.001 && 25 <= 1_000_000_000,
    "25 must be within the supported range";
  assert isFinite(0.8) && 0.8 >= 0,
    "0.8 must be finite and non-negative";
  assert isFinite(2) && 2 > 0.8,
    "2 must be finite and greater than 0.8";


  output channel u24_select: number(capacity: 8, overflow: Overflow.drop_oldest);
  output channel u24_enabled: bool(capacity: 8, overflow: Overflow.drop_oldest);
  output channel u24_code: bytes(maxLength: 2, capacity: 8, overflow: Overflow.drop_oldest);

  record u24_Decoded {
    index: number;
    active: bool;
  }

  pure fn u24_isHigh(level: Logic) -> bool {
    return level == Logic.high;
  }

  pure fn u24_decode() -> u24_Decoded {
    const enabledLow = !u24_isHigh(fusedWire1) && !u24_isHigh(fusedWire1);
    if !(enabledLow && u24_isHigh(fusedWire0)) {
      return { index: -1, active: false };
    }
    return {
      index: (u24_isHigh(fusedWire23) ? 1 : 0)
        + (u24_isHigh(fusedWire24) ? 2 : 0)
        + (u24_isHigh(fusedWire25) ? 4 : 0),
      active: true
    };
  }

  pure fn u24_codeOf(index: number) -> bytes {
    if index < 0 {
      return bytes[0x2d, 0x2d];
    }
    return bytes[0x59, 0x30 + index];
  }

  fn u24_driveY0(low: bool) {
    if low {
      u24_y0_setDrive(0);
    } else {
      u24_y0_setDrive(1);
    }
  }

  fn u24_driveY1(low: bool) {
    if low {
      u24_y1_setDrive(0);
    } else {
      u24_y1_setDrive(1);
    }
  }

  fn u24_driveY2(low: bool) {
    if low {
      u24_y2_setDrive(0);
    } else {
      u24_y2_setDrive(1);
    }
  }

  fn u24_driveY3(low: bool) {
    if low {
      u24_y3_setDrive(0);
    } else {
      u24_y3_setDrive(1);
    }
  }

  fn u24_driveY4(low: bool) {
    if low {
      u24_y4_setDrive(0);
    } else {
      u24_y4_setDrive(1);
    }
  }

  fn u24_driveY5(low: bool) {
    if low {
      u24_y5_setDrive(0);
    } else {
      u24_y5_setDrive(1);
    }
  }

  fn u24_driveY6(low: bool) {
    if low {
      u24_y6_setDrive(0);
    } else {
      u24_y6_setDrive(1);
    }
  }

  fn u24_driveY7(low: bool) {
    if low {
      u24_y7_setDrive(0);
    } else {
      u24_y7_setDrive(1);
    }
  }

  fn u24_applyDecode(value: u24_Decoded) {
    u24_driveY0(value.index == 0);
    u24_driveY1(value.index == 1);
    u24_driveY2(value.index == 2);
    u24_driveY3(value.index == 3);
    u24_driveY4(value.index == 4);
    u24_driveY5(value.index == 5);
    u24_driveY6(value.index == 6);
    u24_driveY7(value.index == 7);
  }

  derived u24_decoded: u24_Decoded = u24_decode();

  process u24_start on u24_started {
    u24_applyDecode(u24_decoded);
    u24_select.send(u24_decoded.index);
    u24_enabled.send(u24_decoded.active);
    u24_code.send(u24_codeOf(u24_decoded.index));
  }

  process u24_changed on u24_decoded {
    u24_applyDecode(u24_decoded);
    u24_select.send(u24_decoded.index);
    u24_enabled.send(u24_decoded.active);
    u24_code.send(u24_codeOf(u24_decoded.index));
  }


  assert 25 >= 0.001 && 25 <= 1_000_000_000,
    "25 must be within the supported range";
  assert isFinite(0.8) && 0.8 >= 0,
    "0.8 must be finite and non-negative";
  assert isFinite(2) && 2 > 0.8,
    "2 must be finite and greater than 0.8";


  pure fn u25_isHigh(level: Logic) -> bool {
    return level == Logic.high;
  }

  fn u25_driveY1(outputHigh: bool) {
    if outputHigh {
      u25_y1_setDrive(1);
    } else {
      u25_y1_setDrive(0);
    }
  }

  fn u25_driveY2(outputHigh: bool) {
    if outputHigh {
      u25_y2_setDrive(1);
    } else {
      u25_y2_setDrive(0);
    }
  }

  fn u25_driveY3(outputHigh: bool) {
    if outputHigh {
      u25_y3_setDrive(1);
    } else {
      u25_y3_setDrive(0);
    }
  }

  fn u25_driveY4(outputHigh: bool) {
    if outputHigh {
      u25_y4_setDrive(1);
    } else {
      u25_y4_setDrive(0);
    }
  }

  derived u25_y1Out: bool = !(u25_isHigh(fusedWire45) || u25_isHigh(fusedWire46));
  derived u25_y2Out: bool = !(u25_isHigh(fusedWire43) || u25_isHigh(fusedWire46));
  derived u25_y3Out: bool = !(u25_isHigh(fusedWire44) || u25_isHigh(fusedWire46));
  derived u25_y4Out: bool = !(u25_isHigh(fusedWire42) || u25_isHigh(fusedWire46));

  process u25_start on u25_started {
    u25_driveY1(u25_y1Out);
    u25_driveY2(u25_y2Out);
    u25_driveY3(u25_y3Out);
    u25_driveY4(u25_y4Out);
  }

  process u25_update1 on u25_y1Out {
    u25_driveY1(u25_y1Out);
  }

  process u25_update2 on u25_y2Out {
    u25_driveY2(u25_y2Out);
  }

  process u25_update3 on u25_y3Out {
    u25_driveY3(u25_y3Out);
  }

  process u25_update4 on u25_y4Out {
    u25_driveY4(u25_y4Out);
  }


  const uart_probe_bitTime = round(1e12 / uartBaud);
  const uart_probe_halfBitTime = floor(uart_probe_bitTime / 2);
  const uart_probe_maxSendLength = 64;

  assert isSafeInteger(uartBaud) && uartBaud >= 1 && uartBaud <= 1_000_000_000,
    "uartBaud must be an integer within 1..1000000000";
  assert isSafeInteger(uart_probe_bitTime) && uart_probe_bitTime >= 2,
    "uartBaud must produce an integer bit time of at least 2 ps";
  assert 25 >= 0.001 && 25 <= 1_000_000_000,
    "25 must be within the supported range";


  input channel uart_probe_send: bytes(
    maxLength: uart_probe_maxSendLength,
    capacity: 8,
    overflow: Overflow.drop_oldest
  );
  // 与 SerialLog 一样保留 4096 个单字节观察消息；单批超限显式报错，不静默丢前缀。
  output channel uart_probe_tx: bytes(maxLength: 1, capacity: 4096, overflow: Overflow.error);
  output channel uart_probe_rx: bytes(maxLength: 1, capacity: 4096, overflow: Overflow.error);

  memory uart_probe_injectBuffer[64];

  /** 注入队列长度；新命令整体替换旧命令。 */
  state uart_probe_injectLength: number = 0;
  /** 每次收到注入命令递增，旧注入用它作废。 */
  state uart_probe_injectionSequence: number = 0;
  /** TXD 最近一次驱动电平，用于取消低电平注入前补一个恢复位。 */
  state uart_probe_txHigh: bool = false;

  /** 接收帧正在进行；帧内新下降沿不重开帧。 */
  state uart_probe_rxBusy: bool = false;
  /** 每次合法起始位递增，触发一次接收过程。 */
  state uart_probe_rxSequence: number = 0;

  /** 未知电平按低：只有 Logic.high 记作高。 */
  derived uart_probe_rxdHigh: bool = fusedWire27 == Logic.high;

  fn uart_probe_driveTxd(high: bool) {
    uart_probe_txHigh = high;
    if high {
      uart_probe_txd_setDrive(1);
    } else {
      uart_probe_txd_setDrive(0);
    }
  }

  /** 把命令字节复制到私有缓冲；复制在同一个调度步内完成。 */
  fn uart_probe_loadInjection(value: bytes) {
    let index = 0;
    while index < value.length {
      store8(uart_probe_injectBuffer, index, value[index]);
      index = index + 1;
    }
    uart_probe_injectLength = value.length;
    uart_probe_injectionSequence = uart_probe_injectionSequence + 1;
  }

  process uart_probe_start on uart_probe_started {
    uart_probe_driveTxd(true);
    // 本过程是 send 通道的唯一消费者，持续接收注入命令。
    loop {
      const value = await uart_probe_send.receive();
      uart_probe_loadInjection(value);
    }
  }

  reaction uart_probe_startFrame on uart_probe_rxdHigh as (previous, current) {
    if previous && !current && !uart_probe_rxBusy {
      uart_probe_rxBusy = true;
      uart_probe_rxSequence = uart_probe_rxSequence + 1;
    }
  }

  process uart_probe_receiveFrame on uart_probe_rxSequence {
    let sampleAt = now() + uart_probe_halfBitTime;
    await ticks(sampleAt - now());

    // 起始位中点必须为低；未知按低，只有确定的高电平判为假起始位。
    if fusedWire27 == Logic.high {
      uart_probe_rxBusy = false;
      return;
    }

    let value = 0;
    let bit = 0;
    while bit < 8 {
      sampleAt = sampleAt + uart_probe_bitTime;
      await ticks(sampleAt - now());
      if fusedWire27 == Logic.high {
        value = value | (1 << bit);
      }
      bit = bit + 1;
    }

    sampleAt = sampleAt + uart_probe_bitTime;
    await ticks(sampleAt - now());
    if fusedWire27 == Logic.high {
      uart_probe_tx.send(bytes[value]);
    }
    // 停止位中点后即可接受紧邻的下一帧起始位；帧错误静默丢弃。
    uart_probe_rxBusy = false;
  }

  process uart_probe_inject on uart_probe_injectionSequence {
    const token = uart_probe_injectionSequence;
    const count = uart_probe_injectLength;

    let index = 0;
    while index < count {
      if token != uart_probe_injectionSequence {
        return;
      }

      // 旧帧被取消时可能停在低电平；先补一个完整高电平，制造新的下降沿。
      if !uart_probe_txHigh {
        uart_probe_driveTxd(true);
        const recoveryAt = now() + uart_probe_bitTime;
        await ticks(recoveryAt - now());
        if token != uart_probe_injectionSequence {
          return;
        }
      }

      const value = load8(uart_probe_injectBuffer, index);
      uart_probe_driveTxd(false);
      let nextAt = now() + uart_probe_bitTime;
      await ticks(nextAt - now());
      if token != uart_probe_injectionSequence {
        return;
      }

      let bit = 0;
      while bit < 8 {
        const high = ((value >> bit) & 1) == 1;
        uart_probe_driveTxd(high);
        nextAt = nextAt + uart_probe_bitTime;
        await ticks(nextAt - now());
        if token != uart_probe_injectionSequence {
          return;
        }
        bit = bit + 1;
      }

      uart_probe_driveTxd(true);
      nextAt = nextAt + uart_probe_bitTime;
      await ticks(nextAt - now());
      if token != uart_probe_injectionSequence {
        return;
      }

      uart_probe_rx.send(bytes[value]);
      index = index + 1;
    }
  }


  assert 0.8 >= 0 && 0.8 <= 5,
    "0.8 must be within 0..5 V";
  assert 2 > 0.8 && 2 <= 5,
    "2 must be above 0.8 and within 5 V";

  /** 数字调制输入；高电平表示载波开启。 */

  input channel ld1_request: bool(capacity: 8, overflow: Overflow.error);
  output channel ld1_carrier: bool(capacity: 16, overflow: Overflow.drop_oldest);

  /** 宿主通过 setCarrier 提交的逻辑请求；与 mod 引脚相或。 */
  state ld1_hostRequest: bool = false;
  /** 已发布给宿主的载波状态，用于抑制启动阶段的重复事件。 */
  state ld1_reportedCarrier: bool = false;

  pure fn ld1_isHigh(level: Logic) -> bool {
    return level == Logic.high;
  }

  pure fn ld1_isLow(level: Logic) -> bool {
    return level == Logic.low;
  }

  /** 只有 VCC 确定拉高且 GND 确定拉低时才认为器件获得供电。 */
  derived ld1_powered: bool = ld1_isHigh(Logic.high) && ld1_isLow(Logic.low);
  /** mod 引脚上的数字调制电平；未知按未调制处理。 */
  derived ld1_modulation: bool = ld1_isHigh(fusedWire95);
  /** 对外可见的逻辑载波。 */
  derived ld1_carrierState: bool = ld1_powered && (ld1_hostRequest || ld1_modulation);

  process ld1_start on ld1_started {
    ld1_reportedCarrier = ld1_carrierState;
    ld1_carrier.send(ld1_carrierState);
    // 启动过程同时是该通道的唯一消费者。
    loop {
      ld1_hostRequest = await ld1_request.receive();
    }
  }

  process ld1_changed on ld1_carrierState {
    if ld1_reportedCarrier != ld1_carrierState {
      ld1_reportedCarrier = ld1_carrierState;
      ld1_carrier.send(ld1_carrierState);
    }
  }

// Board glue for the fused CT107D model. Placeholders are filled by scripts/generate.mjs.

  record SwitchEvent {
    index: number;
    pressed: bool;
  }
  record JumperEvent {
    index: number;
    closed: bool;
  }
  record AmplifierEvent {
    field: number;
    value: number;
  }
  record Lm324Input {
    field: number;
    value: number;
  }
  record LedSignal {
    index: number;
    brightness: number;
    current: number;
    voltage: number;
  }
  record DisplaySignal {
    designator: number;
    digit1: number;
    digit2: number;
    digit3: number;
    digit4: number;
  }
  record SwitchSignal {
    index: number;
    pressed: bool;
  }
  record ActuatorSignal {
    target: number;
    active: bool;
    value: number;
  }
  record ActuatorState {
    relay: bool;
    buzzer: bool;
  }
  record JumperSignal {
    index: number;
    closed: bool;
  }
  record AmplifierSignal {
    position: number;
    gain: number;
    outputVoltage: number;
  }

  /** Matrix keys and independent keys, indexed by the schematic designator. */
  memory keyStates[24];
  /** J13 CON3: true = 2-3 (WR grounded, default IO); false = 1-2 (WR follows P42). */
  state j13Closed: bool = true;
  /** J5 CON3: true = 2-3 (S4-S7 grounded, default independent); false = 1-2 (P44 column). */
  state j5Closed: bool = true;
  state j3Closed: bool = true;
  state j2Vs1838: bool = true;
  /** J2 lower row: false = 1-3 (U18, default), true = 3-5 (LD1). */
  state j2TxToLd1: bool = false;

  input channel switchEvent: SwitchEvent(capacity: 32, overflow: Overflow.drop_oldest);
  input channel jumperEvent: JumperEvent(capacity: 16, overflow: Overflow.drop_oldest);
  input channel amplifierEvent: AmplifierEvent(capacity: 16, overflow: Overflow.drop_oldest);
  input channel lm324Input: Lm324Input(capacity: 16, overflow: Overflow.drop_oldest);

  output channel led: LedSignal(capacity: 256, overflow: Overflow.drop_oldest);
  output channel display: DisplaySignal(capacity: 32, overflow: Overflow.drop_oldest);
  output channel switch: SwitchSignal(capacity: 32, overflow: Overflow.drop_oldest);
  output channel actuator: ActuatorSignal(capacity: 32, overflow: Overflow.drop_oldest);
  /** Complete latest state for the adapter snapshot; capacity 1 is safe because later state replaces older state wholesale. */
  output channel actuatorState: ActuatorState(capacity: 1, overflow: Overflow.drop_oldest);
  output channel jumper: JumperSignal(capacity: 16, overflow: Overflow.drop_oldest);
  output channel amplifier: AmplifierSignal(capacity: 32, overflow: Overflow.drop_oldest);

  /** Last committed seven-segment masks, per display and digit. */
  state ds1Digit1: number = 0;
  state ds1Digit2: number = 0;
  state ds1Digit3: number = 0;
  state ds1Digit4: number = 0;
  state ds2Digit1: number = 0;
  state ds2Digit2: number = 0;
  state ds2Digit3: number = 0;
  state ds2Digit4: number = 0;
  /** Last time the matching scan candidate changed; the digit is stable when this ages by SEG_SETTLE_PS. */
  state ds1Since1: number = 0;
  state ds1Since2: number = 0;
  state ds1Since3: number = 0;
  state ds1Since4: number = 0;
  state ds2Since1: number = 0;
  state ds2Since2: number = 0;
  state ds2Since3: number = 0;
  state ds2Since4: number = 0;

  /** LM324 / RB4 folded analog front-end. */
  state lm324Wiper: number = 0;
  state lm324Position: number = 0;
  state lm324InPlus: number = 0;
  state lm324InMinus: number = 0;
  state lm324Out: number = 0;
  state lm324Gain: number =
    1 + 2 * 100000 /
      (100 + (10000 - 100) * (1 - 0));

  /** Model output snapshots needed by event publication. */
  state ledMask: number = 0;
  state ledsInitialized: bool = false;
  state relayEnergized: bool = false;
  state buzzerActive: bool = false;
  state actuatorsInitialized: bool = false;

