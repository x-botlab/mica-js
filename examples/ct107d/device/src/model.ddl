  derived fusedWire96: Logic = fusedCode96 == 1 ? Logic.high : fusedCode96 == 0 ? Logic.low : Logic.unknown;
  derived fusedVoltage96: number = fusedCode96 == 1 ? 5 : 0;
  derived fusedCode97: number = fusedNet97();
  derived fusedWire97: Logic = fusedCode97 == 1 ? Logic.high : fusedCode97 == 0 ? Logic.low : Logic.unknown;
  derived fusedVoltage97: number = fusedCode97 == 1 ? 5 : 0;
  derived fusedCode98: number = fusedNet98();
  derived fusedWire98: Logic = fusedCode98 == 1 ? Logic.high : fusedCode98 == 0 ? Logic.low : Logic.unknown;
  derived fusedVoltage98: number = fusedCode98 == 1 ? 5 : 0;
  derived fusedCode99: number = fusedNet99();
  derived fusedWire99: Logic = fusedCode99 == 1 ? Logic.high : fusedCode99 == 0 ? Logic.low : Logic.unknown;
  derived fusedVoltage99: number = fusedCode99 == 1 ? 5 : 0;
  derived fusedCode100: number = fusedNet100();
  derived fusedWire100: Logic = fusedCode100 == 1 ? Logic.high : fusedCode100 == 0 ? Logic.low : Logic.unknown;
  derived fusedVoltage100: number = fusedCode100 == 1 ? 5 : 0;
  derived fusedCode101: number = fusedNet101();
  derived fusedWire101: Logic = fusedCode101 == 1 ? Logic.high : fusedCode101 == 0 ? Logic.low : Logic.unknown;
  derived fusedVoltage101: number = fusedCode101 == 1 ? 5 : 0;
  derived fusedCode102: number = fusedNet102();
  derived fusedWire102: Logic = fusedCode102 == 1 ? Logic.high : fusedCode102 == 0 ? Logic.low : Logic.unknown;
  derived fusedVoltage102: number = fusedCode102 == 1 ? 5 : 0;
  derived fusedCode103: number = fusedNet103();
  derived fusedWire103: Logic = fusedCode103 == 1 ? Logic.high : fusedCode103 == 0 ? Logic.low : Logic.unknown;
  derived fusedVoltage103: number = fusedCode103 == 1 ? 5 : 0;
  derived fusedCode104: number = fusedNet104();
  derived fusedWire104: Logic = fusedCode104 == 1 ? Logic.high : fusedCode104 == 0 ? Logic.low : Logic.unknown;
  derived fusedVoltage104: number = fusedCode104 == 1 ? 5 : 0;
  derived fusedCode105: number = fusedNet105();
  derived fusedWire105: Logic = fusedCode105 == 1 ? Logic.high : fusedCode105 == 0 ? Logic.low : Logic.unknown;
  derived fusedVoltage105: number = fusedCode105 == 1 ? 5 : 0;
  derived fusedCode106: number = fusedNet106();
  derived fusedWire106: Logic = fusedCode106 == 1 ? Logic.high : fusedCode106 == 0 ? Logic.low : Logic.unknown;
  derived fusedVoltage106: number = fusedCode106 == 1 ? 5 : 0;
  derived fusedCode107: number = fusedNet107();
  derived fusedWire107: Logic = fusedCode107 == 1 ? Logic.high : fusedCode107 == 0 ? Logic.low : Logic.unknown;
  derived fusedVoltage107: number = fusedCode107 == 1 ? 5 : 0;
  derived fusedCode108: number = fusedNet108();
  derived fusedWire108: Logic = fusedCode108 == 1 ? Logic.high : fusedCode108 == 0 ? Logic.low : Logic.unknown;
  derived fusedVoltage108: number = fusedCode108 == 1 ? 5 : 0;
  derived fusedCode109: number = fusedNet109();
  derived fusedWire109: Logic = fusedCode109 == 1 ? Logic.high : fusedCode109 == 0 ? Logic.low : Logic.unknown;
  derived fusedVoltage109: number = fusedCode109 == 1 ? 5 : 0;
  derived fusedCode110: number = fusedNet110();
  derived fusedWire110: Logic = fusedCode110 == 1 ? Logic.high : fusedCode110 == 0 ? Logic.low : Logic.unknown;
  derived fusedVoltage110: number = fusedCode110 == 1 ? 5 : 0;

  assert isSafeInteger(clockFrequency)
      && clockFrequency >= 1_000_000
      && clockFrequency <= 40_000_000,
    "clockFrequency must be an integer within 1000000..40000000";

  /** 程序存储器：64 KiB 地址空间，物理 Flash 合同为前 60 KiB（0xF000）；JIT 从这里取指。 */
  public memory code[0x10000];
  /** 内部 RAM：低 128 字节直接/间接寻址，高 128 字节仅间接寻址（含堆栈）。 */
  memory iram[0x100];
  /** SFR 锁存器：下标等于 SFR 地址的低 7 位。 */
  memory sfr[0x80];
  /** 片内扩展 RAM：MOVX 访问，1792 字节。 */
  memory xram[0x700];
  /** 外设内部状态：计数余量、移位寄存器、相位与中断栈。 */
  memory periph[0x100];
  /** 片内 EEPROM（Data Flash）：IAP 读写，1 KiB。 */
  memory flash[0x400];

  /**
   * 串口 1 的线上字节流：每个完整帧发布一条单字节消息。
   * capacity 与 shared/serial.ts 的 SERIAL_CAPACITY（4096 字节）对齐；单批超限显式
   * CHANNEL_OVERFLOW，跨批历史仍由 SerialLog 的 cursor/dropped 语义裁剪。
   */
  output channel uart1Tx: bytes(maxLength: 1, capacity: 4096, overflow: Overflow.error);
  /** 串口 1 实际写入接收缓冲的字节：每个完整帧发布一条单字节消息。 */
  output channel uart1Rx: bytes(maxLength: 1, capacity: 4096, overflow: Overflow.error);

  /** 程序计数器；JIT 绑定到这条 state。 */
  state pc: number = 0;
  /**
   * 已记过时间、但还没交给外设的皮秒数（「待推进时间」）。
   *
   * 每条指令在末尾把自己的时钟数累加到这里；服务块把它一次性交给外设并清零。
   * 用累加而不是读宿主时钟，指令块才能只含纯算术、进入直接后端。
   */
  state clockPs: number = 0;
  /**
   * 距离下一次必须进入服务块的安全时间（整数 ps，相对上次统一结算）。
   *
   * - 初始 `0`：尚未结算；一旦有活跃外设，下一个节拍点会做一次保守服务；
   * - `1`：必须在下一个节拍点进入服务（保守回退或配置刚变化）；
   * - 其它正数：`clockPs` 达到该值时才需要服务；
   * - 无定时需求时结算写入内部哨兵 `1e15`（不是 `0`），避免每个节拍点再判空。
   *
   * 使用 number state 而不是 32 位 periph 槽：1 MHz、12T、16 位定时器的最长期限为
   * 65536 × 12 × 10^6 = 786432000000 ps，超出 u32，但在安全整数范围内。
   */
  state serviceDeadline: number = 0;
  /** 各定时器最近一次结算后算出的下一次可观察事件期限；由 timer 外设维护。 */
  state t0Deadline: number = 0;
  state t1Deadline: number = 0;
  state t2Deadline: number = 0;

  /** UART1 默认 RXD（P3_0）的边沿观察开关；禁用时 derived 保持高，不产生候选沿。 */
  state uart1EdgeEnabled: bool = false;
  /** P3_0 已出现高→非高候选沿，等待内核消费。 */
  state uart1Wake: bool = false;
  /** 最近一次候选沿的仿真时刻（ps）。 */
  state uart1EdgeAt: number = 0;
  /**
   * 当前候选沿是否可作为起始位。每次接受候选沿后置否，线上回到高电平后才恢复；
   * 因此一段连续低电平只能开一帧，下一帧必须来自新的高→低电平。
   */
  state uart1EdgeArmed: bool = true;
  /** UART1 接收配置快照：bit0-1 有效模式、bit2-3 路由、bit4 REN；初值与复位一致。 */
  state uart1RxConfig: number = 0;

  /** 未知电平按低：只有确定的高电平记作高；禁用时保持高。 */
  derived uart1RxHigh: bool = !uart1EdgeEnabled || fusedWire26 == Logic.high;

  /**
   * P3_0 高→非高候选沿：记录时刻；只有仍然保有资格的候选才置唤醒。
   *
   * 唤醒同时消费资格，保证同一段低电平不会被重复当成起始位。
   */
  reaction uart1RxEdge on uart1RxHigh as (previous, current) {
    if previous && !current {
      uart1EdgeAt = now();
      if uart1EdgeArmed {
        uart1Wake = true;
        uart1EdgeArmed = false;
      }
    }
    if !previous && current {
      uart1EdgeArmed = true;
    }
  }

  /**
   * 复位值：SP=07H、PCON=30H、AUXR=01H、SPCTL=04H、P0–P4 锁存全 1（准双向、释放）。
   * 其余 SFR 与 `periph` 按零初始化；启动过程先于 JIT 的第一条指令执行。
   *
   * 端口引脚的初始意图就是复位后的准双向弱上拉（10 kΩ 到 VCC），不是 unknown 或
   * 高阻。这样第一条 `MOV A,P3` / `JB P3.2` 在没有任何外部上拉时也能读到高；外部
   * 强下拉仍然按电阻分压覆盖弱上拉。P4 的 weak-up 同样从复位时刻生效。
   */
  process u1_start on u1_started {
    store8(sfr, 0x00, 0xff);
    store8(sfr, 0x01, 0x07);
    store8(sfr, 0x07, 0x30);
    store8(sfr, 0x0e, 0x01);
    store8(sfr, 0x10, 0xff);
    store8(sfr, 0x20, 0xff);
    store8(sfr, 0x30, 0xff);
    store8(sfr, 0x40, 0xff);
    store8(sfr, 0x4e, 0x04);
  }
  /** P4.2 可复用 WR；本模型按 GPIO 参与口模式与键盘列。 */
  /** P4.4 可复用 RD；本模型按 GPIO 参与口模式与键盘列。 */

  /** 供电与地：装配必须把它们接到固定电位网络，推挽输出才有参考。 */


  assert 25 >= 0.001 && 25 <= 1_000_000_000,
    "25 must be within the supported range";
  assert 0.8 >= 0 && 0.8 <= 5,
    "0.8 must be within 0..5 V";
  assert 2 > 0.8 && 2 <= 5,
    "2 must be above 0.8 and within 5 V";


  memory u4_storage[256];

  output channel u4_dump: bytes(
    maxLength: 256,
    capacity: 4,
    overflow: Overflow.drop_oldest
  );

  enum u4_Phase {
    idle,
    receiveAddress,
    receiveWordAddress,
    receiveData,
    acknowledge,
    transmit,
    masterAck,
    ignore
  }

  record u4_BusCodes {
    clockCode: number;
    dataCode: number;
  }

  state u4_phase: u4_Phase = u4_Phase.idle;
  state u4_receiveShift: number = 0;
  state u4_receiveBits: number = 0;
  state u4_addressLow: number = 0;
  state u4_pointer: number = 0;
  state u4_nextPhase: u4_Phase = u4_Phase.idle;
  state u4_transmitByte: number = 0;
  state u4_transmitBits: number = 0;
  state u4_masterAck: bool = false;
  state u4_masterAckSampled: bool = false;
  state u4_sinking: bool = false;

  /** 未知电平按低处理：只有 Logic.high 记作 1。 */
  pure fn u4_sampleBit(level: Logic) -> number {
    if level == Logic.high {
      return 1;
    }
    return 0;
  }

  /** 总线编码保留未知：高=1、低=0、未知=2。 */
  pure fn u4_busCode(level: Logic) -> number {
    if level == Logic.high {
      return 1;
    } else if level == Logic.low {
      return 0;
    }
    return 2;
  }

  derived u4_busCodes: u4_BusCodes = {
    clockCode: u4_busCode(fusedWire18),
    dataCode: u4_busCode(fusedWire19)
  };

  fn u4_sink(enabled: bool) {
    u4_sinking = enabled;
    if u4_sinking {
      u4_sda_setDrive(0);
    } else {
      u4_sda_setDrive(4);
    }
  }

  fn u4_acknowledge(next: u4_Phase) {
    u4_nextPhase = next;
    u4_sink(true);
    u4_phase = u4_Phase.acknowledge;
  }

  fn u4_writeDataByte(value: number, protectedLine: bool) {
    // WP 高电平丢弃数据，也不推进指针；无论是否写入都必须应答。
    if !protectedLine {
      const index = u4_pointer & 255;
      const previous = load8(u4_storage, index);
      store8(u4_storage, index, value);
      // 页写缓冲区只在 8 字节页内回绕。
      u4_pointer = (u4_pointer & 248) | ((u4_pointer + 1) & 7);
      if previous != value {
        u4_dump.send(copyBytes(u4_storage, 0, 256));
      }
    }
  }

  fn u4_finishReceivedByte(protectedLine: bool) {
    const byte = u4_receiveShift;
    u4_receiveShift = 0;
    u4_receiveBits = 0;

    if u4_phase == u4_Phase.receiveAddress {
      const matches = (byte & 240) == 160 && ((byte >> 1) & 7) == u4_addressLow;
      if matches {
        if (byte & 1) == 1 {
          u4_acknowledge(u4_Phase.transmit);
        } else {
          u4_acknowledge(u4_Phase.receiveWordAddress);
        }
      } else {
        u4_phase = u4_Phase.ignore;
        u4_sink(false);
      }
    } else if u4_phase == u4_Phase.receiveWordAddress {
      u4_pointer = byte;
      u4_acknowledge(u4_Phase.receiveData);
    } else if u4_phase == u4_Phase.receiveData {
      u4_writeDataByte(byte, protectedLine);
      u4_acknowledge(u4_Phase.receiveData);
    }
  }

  fn u4_placeTransmitBit() {
    if u4_transmitBits < 8 {
      const position = 7 - u4_transmitBits;
      const bit = (u4_transmitByte >> position) & 1;
      u4_sink(bit == 0);
      u4_transmitBits = u4_transmitBits + 1;
    } else {
      // 8 位发完，释放 SDA 让主机驱动第 9 个时钟的 ACK/NACK。
      u4_sink(false);
      u4_phase = u4_Phase.masterAck;
      u4_masterAckSampled = false;
    }
  }

  fn u4_beginTransmit() {
    u4_transmitByte = load8(u4_storage, u4_pointer);
    u4_transmitBits = 0;
    u4_phase = u4_Phase.transmit;
    // 读指针在整个 256 字节阵列内回绕，不按页回绕。
    u4_pointer = (u4_pointer + 1) & 255;
    u4_placeTransmitBit();
  }

  process u4_start on u4_started {
    u4_sink(false);
    u4_dump.send(copyBytes(u4_storage, 0, 256));
  }

  reaction u4_busEdge on u4_busCodes as (previous, current)
    capture dataLevel = fusedWire19,
      addressA0 = fusedWire1,
      addressA1 = fusedWire1,
      addressA2 = fusedWire1,
      writeProtect = fusedWire1 {
    const clockHigh = current.clockCode == 1;
    const clockWasHigh = previous.clockCode == 1;
    const dataHigh = current.dataCode == 1;
    const dataWasHigh = previous.dataCode == 1;

    if clockWasHigh && clockHigh && dataWasHigh && !dataHigh {
      // START / 重复 START：主机重新掌握 SDA，并在此刻锁存 A2..A0。
      u4_sink(false);
      u4_phase = u4_Phase.receiveAddress;
      u4_receiveShift = 0;
      u4_receiveBits = 0;
      u4_addressLow = u4_sampleBit(addressA2) * 4 +
        u4_sampleBit(addressA1) * 2 +
        u4_sampleBit(addressA0);
    } else if clockWasHigh && clockHigh && !dataWasHigh && dataHigh {
      // STOP：结束当前事务，释放 SDA。
      u4_sink(false);
      u4_phase = u4_Phase.idle;
      u4_receiveShift = 0;
      u4_receiveBits = 0;
    } else if !clockWasHigh && clockHigh {
      // SCL 上升沿：接收阶段采样主机数据位，主机 ACK 阶段采样 ACK/NACK。
      const receiving = u4_phase == u4_Phase.receiveAddress ||
        u4_phase == u4_Phase.receiveWordAddress ||
        u4_phase == u4_Phase.receiveData;
      if receiving && u4_receiveBits < 8 {
        u4_receiveShift = (u4_receiveShift << 1) | u4_sampleBit(dataLevel);
        u4_receiveBits = u4_receiveBits + 1;
      } else if u4_phase == u4_Phase.masterAck && !u4_masterAckSampled {
        // 主机拉低表示 ACK（继续发送）；高电平表示 NACK。未知按低处理。
        u4_masterAck = dataLevel != Logic.high;
        u4_masterAckSampled = true;
      }
    } else if clockWasHigh && !clockHigh {
      // SCL 下降沿：第 8 个下降沿完成接收字节，第 9 个下降沿推进状态机。
      const receiving = u4_phase == u4_Phase.receiveAddress ||
        u4_phase == u4_Phase.receiveWordAddress ||
        u4_phase == u4_Phase.receiveData;
      if receiving && u4_receiveBits == 8 {
        u4_finishReceivedByte(writeProtect == Logic.high);
      } else if u4_phase == u4_Phase.acknowledge {
        u4_sink(false);
        if u4_nextPhase == u4_Phase.transmit {
          u4_beginTransmit();
        } else {
          u4_phase = u4_nextPhase;
          u4_receiveShift = 0;
          u4_receiveBits = 0;
        }
      } else if u4_phase == u4_Phase.transmit {
        u4_placeTransmitBit();
      } else if u4_phase == u4_Phase.masterAck && u4_masterAckSampled {
        if u4_masterAck {
          u4_beginTransmit();
        } else {
          u4_phase = u4_Phase.ignore;
          u4_sink(false);
        }
      }
    }
  }


  const u5_MICROSECOND = 1_000_000;
  const u5_WRITE_SAMPLE_DELAY = 15 * u5_MICROSECOND;
  const u5_READ_ZERO_HOLD = 15 * u5_MICROSECOND;
  const u5_CONVERT_TIME = 750_000_000_000;

  assert isSafeInteger(47049) && 47049 >= 0 && 47049 <= 0xffffffff,
    "47049 must be an unsigned 32-bit integer";
  assert 25 >= 0.001 && 25 <= 1_000_000_000,
    "25 must be within the supported range";
  assert 0.8 >= 0 && 0.8 <= 5,
    "0.8 must be within 0..5 V";
  assert 2 > 0.8 && 2 <= 5,
    "2 must be above 0.8 and within 5 V";


  input channel u5_temperature: number(capacity: 8, overflow: Overflow.error);
  output channel u5_temperatureOut: number(capacity: 4, overflow: Overflow.drop_oldest);

  memory u5_scratchpad[9];

  enum u5_Phase {
    idle,
    command,
    receive,
    transmit,
    silent
  }

  enum u5_Stage {
    romCommand,
    functionCommand
  }

  enum u5_RxTarget {
    matchRom,
    writeConfig
  }

  enum u5_TxSource {
    romBytes,
    scratchpadBytes
  }

  state u5_phase: u5_Phase = u5_Phase.idle;
  state u5_stage: u5_Stage = u5_Stage.romCommand;
  state u5_rxTarget: u5_RxTarget = u5_RxTarget.matchRom;
  state u5_rxByte: number = 0;
  state u5_rxBits: number = 0;
  state u5_romIndex: number = 0;
  state u5_configIndex: number = 0;
  state u5_txSource: u5_TxSource = u5_TxSource.romBytes;
  state u5_txCount: number = 0;
  state u5_txByte: number = 0;
  state u5_txBit: number = 0;
  state u5_ambient: number = 25;

  /** 本器件自己的拉低标记：用于把存在脉冲/读 0 位的边沿与主机边沿区分开。 */
  state u5_sinking: bool = false;
  state u5_lastFallSelf: bool = false;
  state u5_fallTime: number = 0;
  /** 每次总线复位递增；写时隙、存在脉冲与读 0 位释放用它判断请求是否过期。 */
  state u5_busGeneration: number = 0;

  state u5_slotAt: number = 0;
  state u5_slotGeneration: number = 0;
  state u5_slotSequence: number = 0;

  state u5_presenceAt: number = 0;
  state u5_presenceSequence: number = 0;

  state u5_releaseAt: number = 0;
  state u5_releaseGeneration: number = 0;
  state u5_releaseSequence: number = 0;

  state u5_convertAt: number = 0;
  state u5_convertSequence: number = 0;

  // --- 纯函数：CRC8、ROM 内容、暂存器内容 ---------------------------------------------

  /** Dallas CRC8（多项式 0x31 / 反向 0x8C）的单字节推进。 */
  pure fn u5_crcStep(crc: number, byte: number) -> number {
    let value = crc ^ byte;
    let bit = 0;
    while bit < 8 {
      if value % 2 == 1 {
        value = floor(value / 2) ^ 0x8c;
      } else {
        value = floor(value / 2);
      }
      bit = bit + 1;
    }
    return value;
  }

  /** ROM 前 7 字节：族码 0x28、47049 低 32 位（低位在前）、两个 0x00。 */
  pure fn u5_romBody(index: number) -> number {
    if index == 0 {
      return 0x28;
    }
    if index == 1 {
      return 47049 % 256;
    }
    if index == 2 {
      return floor(47049 / 256) % 256;
    }
    if index == 3 {
      return floor(47049 / 65536) % 256;
    }
    if index == 4 {
      return floor(47049 / 16777216) % 256;
    }
    return 0;
  }

  /** ROM 第 8 字节：工厂期算好的 Dallas CRC8。 */
  pure fn u5_romCrc() -> number {
    let crc = 0;
    let index = 0;
    while index < 7 {
      crc = u5_crcStep(crc, u5_romBody(index));
      index = index + 1;
    }
    return crc;
  }

  pure fn u5_romByte(index: number) -> number {
    if index < 7 {
      return u5_romBody(index);
    }
    return u5_romCrc();
  }

  /** 暂存器第 9 字节（索引 8）是前 8 字节的动态 CRC8。 */
  pure fn u5_scratchpadCrc() -> number {
    let crc = 0;
    let index = 0;
    while index < 8 {
      crc = u5_crcStep(crc, load8(u5_scratchpad, index));
      index = index + 1;
    }
    return crc;
  }

  pure fn u5_scratchpadByte(index: number) -> number {
    if index < 8 {
      return load8(u5_scratchpad, index);
    }
    return u5_scratchpadCrc();
  }

  pure fn u5_transmitValue(source: u5_TxSource, index: number) -> number {
    if source == u5_TxSource.romBytes {
      return u5_romByte(index);
    }
    return u5_scratchpadByte(index);
  }

  /** 四舍五入，恰为中点时远离零（旧模型行为，区别于 Math.round）。 */
  pure fn u5_roundHalfAway(value: number) -> number {
    const truncated = trunc(value);
    const residual = value - truncated;
    if residual >= 0.5 {
      return truncated + 1;
    }
    if residual <= -0.5 {
      return truncated - 1;
    }
    return truncated;
  }

  derived u5_dqHigh: bool = fusedWire14 == Logic.high;

  // --- 引脚驱动 -------------------------------------------------------------------

  fn u5_sinkLine(active: bool) {
    u5_sinking = active;
    if active {
      u5_dq_setDrive(0);
    } else {
      u5_dq_setDrive(4);
    }
  }

  fn u5_armRelease() {
    u5_releaseGeneration = u5_busGeneration;
    // 以读时隙下降沿为绝对基准，+15 us 释放；不能从决策时刻再开始计时。
    u5_releaseAt = u5_fallTime + u5_READ_ZERO_HOLD;
    u5_releaseSequence = u5_releaseSequence + 1;
  }

  // --- 协议：写位采样、读位驱动 -----------------------------------------------------

  fn u5_acceptByte(value: number) {
    if u5_phase == u5_Phase.command {
      if u5_stage == u5_Stage.romCommand {
        if value == 0xcc {
          u5_stage = u5_Stage.functionCommand;
        } else if value == 0x33 {
          u5_beginTransmit(u5_TxSource.romBytes);
        } else if value == 0x55 {
          u5_phase = u5_Phase.receive;
          u5_rxTarget = u5_RxTarget.matchRom;
          u5_romIndex = 0;
        } else {
          // 0xF0 Search ROM / 0xEC Alarm Search 未实现，未知 ROM 命令静默。
          u5_phase = u5_Phase.idle;
        }
      } else {
        if value == 0x44 {
          u5_beginConversion();
        } else if value == 0xbe {
          u5_beginTransmit(u5_TxSource.scratchpadBytes);
        } else if value == 0x4e {
          u5_phase = u5_Phase.receive;
          u5_rxTarget = u5_RxTarget.writeConfig;
          u5_configIndex = 0;
        } else {
          // 0xB4 Read Power Supply / 0xB8 Copy Scratchpad 与未知命令：静默空操作。
          u5_phase = u5_Phase.idle;
        }
      }
    } else if u5_phase == u5_Phase.receive {
      if u5_rxTarget == u5_RxTarget.matchRom {
        if value == u5_romByte(u5_romIndex) {
          u5_romIndex = u5_romIndex + 1;
          if u5_romIndex == 8 {
            u5_stage = u5_Stage.functionCommand;
            u5_phase = u5_Phase.command;
          }
        } else {
          u5_phase = u5_Phase.silent;
        }
      } else {
        store8(u5_scratchpad, 2 + u5_configIndex, value);
        u5_configIndex = u5_configIndex + 1;
        if u5_configIndex == 3 {
          u5_configIndex = 0;
          u5_phase = u5_Phase.idle;
        }
      }
    }
  }

  fn u5_sampleSlot() {
    if u5_slotGeneration != u5_busGeneration {
      return;
    }
    if u5_phase != u5_Phase.command && u5_phase != u5_Phase.receive {
      return;
    }
    const level = fusedWire14 == Logic.high ? 1 : 0;
    u5_rxByte = u5_rxByte + level * pow(2, u5_rxBits);
    u5_rxBits = u5_rxBits + 1;
    if u5_rxBits == 8 {
      const value = u5_rxByte;
      u5_rxByte = 0;
      u5_rxBits = 0;
      u5_acceptByte(value);
    }
  }

  /** 读时隙在下降沿立即消费一位：0 位立即拉低，1 位保持释放。 */
  fn u5_driveSlot() {
    if u5_slotGeneration != u5_busGeneration {
      return;
    }
    if u5_phase != u5_Phase.transmit {
      return;
    }
    const value = u5_transmitValue(u5_txSource, u5_txByte);
    const bit = floor(value / pow(2, u5_txBit)) % 2;
    u5_txBit = u5_txBit + 1;
    if u5_txBit == 8 {
      u5_txBit = 0;
      u5_txByte = u5_txByte + 1;
      if u5_txByte >= u5_txCount {
        u5_phase = u5_Phase.idle;
      }
    }
    if bit == 0 {
      u5_sinkLine(true);
      u5_armRelease();
    }
  }

  fn u5_beginTransmit(source: u5_TxSource) {
    u5_txSource = source;
    u5_txByte = 0;
    u5_txBit = 0;
    if source == u5_TxSource.romBytes {
      u5_txCount = 8;
    } else {
      u5_txCount = 9;
    }
    u5_phase = u5_Phase.transmit;
  }

  fn u5_beginConversion() {
    // 正在转换时忽略新的 Convert T：官方模板每 50 ms 读一次温度，每次都会发 Convert T，
    // 若每次都重启 750 ms 定时器就永远拿不到结果。
    if u5_convertAt <= now() {
      u5_convertAt = now() + u5_CONVERT_TIME;
      u5_convertSequence = u5_convertSequence + 1;
    }
    u5_phase = u5_Phase.idle;
  }

  fn u5_finishConversion() {
    let raw = u5_roundHalfAway(u5_ambient * 16);
    if raw < 0 {
      raw = raw + 65536;
    }
    store8(u5_scratchpad, 0, raw % 256);
    store8(u5_scratchpad, 1, floor(raw / 256) % 256);
    u5_temperatureOut.send(u5_ambient);
  }

  // --- 边沿处理 -------------------------------------------------------------------

  /** 主机下降沿开时隙；>= 480 us 的低脉冲在上升沿判为复位。 */
  fn u5_openSlot() {
    u5_slotGeneration = u5_busGeneration;
    if u5_phase == u5_Phase.transmit {
      // 读时隙在反应体内同步消费并立即驱动 0 位；不经过可挂起 process，
      // 避免旧时隙的等待把下降沿后的即时驱动推迟到旧期限。
      u5_driveSlot();
    } else if u5_phase == u5_Phase.command || u5_phase == u5_Phase.receive {
      // 写时隙：从机在下降沿 +15 us 采样。
      u5_slotAt = now() + u5_WRITE_SAMPLE_DELAY;
      u5_slotSequence = u5_slotSequence + 1;
    }
  }

  fn u5_busReset() {
    u5_busGeneration = u5_busGeneration + 1;
    u5_phase = u5_Phase.command;
    u5_stage = u5_Stage.romCommand;
    u5_rxByte = 0;
    u5_rxBits = 0;
    u5_romIndex = 0;
    u5_configIndex = 0;
    u5_txByte = 0;
    u5_txBit = 0;
    u5_presenceAt = now() + 30 * u5_MICROSECOND;
    u5_presenceSequence = u5_presenceSequence + 1;
  }

  fn u5_initializeScratchpad() {
    // 上电暂存器：+25.0 C（0x0190）、TH = 75、TL = 70、12 位配置 0x5F、保留字节。
    store8(u5_scratchpad, 0, 0x90);
    store8(u5_scratchpad, 1, 0x01);
    store8(u5_scratchpad, 2, 75);
    store8(u5_scratchpad, 3, 70);
    store8(u5_scratchpad, 4, 0x5f);
    store8(u5_scratchpad, 5, 0xff);
    store8(u5_scratchpad, 6, 0x0c);
    store8(u5_scratchpad, 7, 0x00);
  }

  process u5_start on u5_started {
    u5_initializeScratchpad();
    loop {
      const value = await u5_temperature.receive();
      // 非有限值不改变注入温度。
      if isFinite(value) {
        u5_ambient = value;
      }
    }
  }

  reaction u5_dqEdge on u5_dqHigh as (previous, current) {
    if previous && !current {
      // 自己拉低产生的下降沿不开放时隙。
      u5_lastFallSelf = u5_sinking;
      if !u5_sinking {
        u5_fallTime = now();
        u5_openSlot();
      }
    } else if !previous && current {
      if !u5_lastFallSelf {
        if now() - u5_fallTime >= 480 * u5_MICROSECOND {
          u5_busReset();
        }
      }
      u5_lastFallSelf = false;
    }
  }

  /**
   * 写时隙在下降沿 +15 us 采样。process on 是非重入的：等待期间的新触发只记
   * pending，不会提前唤醒；旧等待被唤醒后若序号已变必须让位，由 pending 重跑
   * 等待当前绝对期限，避免同一时隙被重复采样。
   */
  process u5_slotTimer on u5_slotSequence {
    if u5_slotSequence == 0 {
      return;
    }
    const sequence = u5_slotSequence;
    loop {
      const remaining = u5_slotAt - now();
      if remaining <= 0 {
        if sequence == u5_slotSequence {
          u5_sampleSlot();
        }
        return;
      }
      await ticks(remaining);
      if sequence != u5_slotSequence {
        return;
      }
    }
  }

  /** 存在脉冲：下降沿 +30 us 拉低，保持 90 us 后释放；被新复位取代后不再改线。 */
  process u5_presenceTimer on u5_presenceSequence {
    if u5_presenceSequence == 0 {
      return;
    }
    const sequence = u5_presenceSequence;
    const generation = u5_busGeneration;
    loop {
      const remaining = u5_presenceAt - now();
      if remaining <= 0 {
        break;
      }
      await ticks(remaining);
      if sequence != u5_presenceSequence || generation != u5_busGeneration {
        return;
      }
    }
    if sequence != u5_presenceSequence || generation != u5_busGeneration {
      return;
    }
    u5_sinkLine(true);
    await ticks(90 * u5_MICROSECOND);
    if sequence == u5_presenceSequence && generation == u5_busGeneration {
      u5_sinkLine(false);
    }
  }

  /** 读 0 位的释放：以读时隙下降沿为基准，+15 us 撤销从机驱动。 */
  process u5_releaseTimer on u5_releaseSequence {
    if u5_releaseSequence == 0 {
      return;
    }
    const sequence = u5_releaseSequence;
    loop {
      const remaining = u5_releaseAt - now();
      if remaining <= 0 {
        // 新读位或复位已经接管总线时，旧释放不得释放新的拉低驱动。
        if sequence == u5_releaseSequence && u5_releaseGeneration == u5_busGeneration {
          u5_sinkLine(false);
        }
        return;
      }
      await ticks(remaining);
      if sequence != u5_releaseSequence || u5_releaseGeneration != u5_busGeneration {
        return;
      }
    }
  }

  /** Convert T：固定 750 ms 后采样注入温度并写入暂存器；总线复位不取消这次转换。 */
  process u5_convertTimer on u5_convertSequence {
    if u5_convertSequence == 0 {
      return;
    }
    loop {
      const remaining = u5_convertAt - now();
      if remaining <= 0 {
        u5_finishConversion();
        return;
      }
      await ticks(remaining);
    }
  }


  assert 25 >= 0.001 && 25 <= 1_000_000_000,
    "25 must be within the supported range";
  assert isFinite(0.8) && 0.8 >= 0,
    "0.8 must be finite and non-negative";
  assert isFinite(2) && 2 > 0.8,
    "2 must be finite and greater than 0.8";


  output channel u6_latch: number(capacity: 8, overflow: Overflow.drop_oldest);

  /** 最近一次锁存的字节，与 Q 是否被 OE# 释放无关。 */
  state u6_stored: number = 0;

  pure fn u6_bit(level: Logic) -> number {
    if level == Logic.high {
      return 1;
    }
    return 0;
  }

  pure fn u6_dataByte() -> number {
    return u6_bit(fusedWire2)
      + u6_bit(fusedWire3) * 2
      + u6_bit(fusedWire4) * 4
      + u6_bit(fusedWire5) * 8
      + u6_bit(fusedWire6) * 16
      + u6_bit(fusedWire7) * 32
      + u6_bit(fusedWire8) * 64
      + u6_bit(fusedWire9) * 128;
  }

  derived u6_transparent: bool = fusedWire47 == Logic.high;
  derived u6_outputsEnabled: bool = fusedWire1 == Logic.low;
  derived u6_inputs: number = u6_dataByte();

  /**
   * 透明阶段的观察源：LE 为高时记录当刻 D 字节；LE 为低时记录固定占位值 0。
   *
   * 非透明阶段的 value 不读取 D，因此 D 变化不会改变记录；这既避免重算 dataByte，
   * 也不会唤醒 follow。静态订阅仍覆盖两个分支的依赖，D 发布只会触发一次求值。
   */
  record u6_FollowState {
    transparent: bool;
    value: number;
  }

  derived u6_followState: u6_FollowState = u6_transparent
    ? { transparent: true, value: u6_dataByte() }
    : { transparent: false, value: 0 };

  fn u6_driveBit(index: number, level: number) {
    if !u6_outputsEnabled {
      match index {
        0 => { u6_q0_setDrive(4); }
        1 => { u6_q1_setDrive(4); }
        2 => { u6_q2_setDrive(4); }
        3 => { u6_q3_setDrive(4); }
        4 => { u6_q4_setDrive(4); }
        5 => { u6_q5_setDrive(4); }
        6 => { u6_q6_setDrive(4); }
        _ => { u6_q7_setDrive(4); }
      }
    } else if level == 1 {
      match index {
        0 => { u6_q0_setDrive(1); }
        1 => { u6_q1_setDrive(1); }
        2 => { u6_q2_setDrive(1); }
        3 => { u6_q3_setDrive(1); }
        4 => { u6_q4_setDrive(1); }
        5 => { u6_q5_setDrive(1); }
        6 => { u6_q6_setDrive(1); }
        _ => { u6_q7_setDrive(1); }
      }
    } else {
      match index {
        0 => { u6_q0_setDrive(0); }
        1 => { u6_q1_setDrive(0); }
        2 => { u6_q2_setDrive(0); }
        3 => { u6_q3_setDrive(0); }
        4 => { u6_q4_setDrive(0); }
        5 => { u6_q5_setDrive(0); }
        6 => { u6_q6_setDrive(0); }
        _ => { u6_q7_setDrive(0); }
      }
    }
  }

  fn u6_publishAll() {
    u6_driveBit(0, (u6_stored >> 0) & 1);
    u6_driveBit(1, (u6_stored >> 1) & 1);
    u6_driveBit(2, (u6_stored >> 2) & 1);
    u6_driveBit(3, (u6_stored >> 3) & 1);
    u6_driveBit(4, (u6_stored >> 4) & 1);
    u6_driveBit(5, (u6_stored >> 5) & 1);
    u6_driveBit(6, (u6_stored >> 6) & 1);
    u6_driveBit(7, (u6_stored >> 7) & 1);
  }

  process u6_start on u6_started {
    // 573 只在 LE 为高时透明跟随 D。上电时 LE 已低的口不应伪造一次「锁存」；
    // 保持 stored=0 的确定性初始值，等第一个透明相位或下降沿再更新。latch 仍发布
    // 这个确定初始值，便于观察端不需要区分「尚未发布」与「锁存为 0」。
    if fusedWire47 == Logic.high {
      const current = u6_inputs;
      u6_stored = current;
    }
    u6_latch.send(u6_stored);
    u6_publishAll();
  }

  /** 透明阶段：LE 为高时 D 的任意变化直接传到 Q。 */
  process u6_follow on u6_followState {
    if !u6_followState.transparent {
      return;
    }
    const current = u6_followState.value;
    u6_stored = current;
    u6_latch.send(current);
    u6_publishAll();
  }

  /** LE 下降沿：锁存此刻的字节。 */
  reaction u6_latchEdge on fusedWire47 as (previous, current) {
    if previous == Logic.high && current != Logic.high {
      const value = u6_inputs;
      u6_stored = value;
      u6_latch.send(value);
      u6_publishAll();
    }
  }

  /** OE# 变化只影响输出使能。 */
  reaction u6_enableChanged on fusedWire1 as (previous, current) {
    u6_publishAll();
  }


  assert 25 >= 0.001 && 25 <= 1_000_000_000,
    "25 must be within the supported range";
  assert isFinite(0.8) && 0.8 >= 0,
    "0.8 must be finite and non-negative";
  assert isFinite(2) && 2 > 0.8,
    "2 must be finite and greater than 0.8";


  output channel u7_latch: number(capacity: 8, overflow: Overflow.drop_oldest);

  /** 最近一次锁存的字节，与 Q 是否被 OE# 释放无关。 */
  state u7_stored: number = 0;

  pure fn u7_bit(level: Logic) -> number {
    if level == Logic.high {
      return 1;
    }
    return 0;
  }

  pure fn u7_dataByte() -> number {
    return u7_bit(fusedWire2)
      + u7_bit(fusedWire3) * 2
      + u7_bit(fusedWire4) * 4
      + u7_bit(fusedWire5) * 8
      + u7_bit(fusedWire6) * 16
      + u7_bit(fusedWire7) * 32
      + u7_bit(fusedWire8) * 64
      + u7_bit(fusedWire9) * 128;
  }

  derived u7_transparent: bool = fusedWire50 == Logic.high;
  derived u7_outputsEnabled: bool = fusedWire1 == Logic.low;
  derived u7_inputs: number = u7_dataByte();

  /**
   * 透明阶段的观察源：LE 为高时记录当刻 D 字节；LE 为低时记录固定占位值 0。
   *
   * 非透明阶段的 value 不读取 D，因此 D 变化不会改变记录；这既避免重算 dataByte，
   * 也不会唤醒 follow。静态订阅仍覆盖两个分支的依赖，D 发布只会触发一次求值。
   */
  record u7_FollowState {
    transparent: bool;
    value: number;
  }

  derived u7_followState: u7_FollowState = u7_transparent
    ? { transparent: true, value: u7_dataByte() }
    : { transparent: false, value: 0 };

  fn u7_publishAll() {
    if u7_outputsEnabled {
      u7_drive_setDrive(u7_stored);
    } else {
      u7_drive_setDrive(-1);
    }
  }

  process u7_start on u7_started {
    // 573 只在 LE 为高时透明跟随 D。上电时 LE 已低的口不应伪造一次「锁存」；
    // 保持 stored=0 的确定性初始值，等第一个透明相位或下降沿再更新。latch 仍发布
    // 这个确定初始值，便于观察端不需要区分「尚未发布」与「锁存为 0」。
    if fusedWire50 == Logic.high {
      const current = u7_inputs;
      u7_stored = current;
    }
    u7_latch.send(u7_stored);
    u7_publishAll();
  }

  /** 透明阶段：LE 为高时 D 的任意变化直接传到 Q。 */
  process u7_follow on u7_followState {
    if !u7_followState.transparent {
      return;
    }
    const current = u7_followState.value;
    u7_stored = current;
    u7_latch.send(current);
    u7_publishAll();
  }

  /** LE 下降沿：锁存此刻的字节。 */
  reaction u7_latchEdge on fusedWire50 as (previous, current) {
    if previous == Logic.high && current != Logic.high {
      const value = u7_inputs;
      u7_stored = value;
      u7_latch.send(value);
      u7_publishAll();
    }
  }

  /** OE# 变化只影响输出使能。 */
  reaction u7_enableChanged on fusedWire1 as (previous, current) {
    u7_publishAll();
  }


  assert 25 >= 0.001 && 25 <= 1_000_000_000,
    "25 must be within the supported range";
  assert isFinite(0.8) && 0.8 >= 0,
    "0.8 must be finite and non-negative";
  assert isFinite(2) && 2 > 0.8,
    "2 must be finite and greater than 0.8";


  output channel u8_latch: number(capacity: 8, overflow: Overflow.drop_oldest);

  /** 最近一次锁存的字节，与 Q 是否被 OE# 释放无关。 */
  state u8_stored: number = 0;

  pure fn u8_bit(level: Logic) -> number {
    if level == Logic.high {
      return 1;
    }
    return 0;
  }

  pure fn u8_dataByte() -> number {
    return u8_bit(fusedWire2)
      + u8_bit(fusedWire3) * 2
      + u8_bit(fusedWire4) * 4
      + u8_bit(fusedWire5) * 8
      + u8_bit(fusedWire6) * 16
      + u8_bit(fusedWire7) * 32
      + u8_bit(fusedWire8) * 64
      + u8_bit(fusedWire9) * 128;
  }

  derived u8_transparent: bool = fusedWire49 == Logic.high;
  derived u8_outputsEnabled: bool = fusedWire1 == Logic.low;
  derived u8_inputs: number = u8_dataByte();

  /**
   * 透明阶段的观察源：LE 为高时记录当刻 D 字节；LE 为低时记录固定占位值 0。
   *
   * 非透明阶段的 value 不读取 D，因此 D 变化不会改变记录；这既避免重算 dataByte，
   * 也不会唤醒 follow。静态订阅仍覆盖两个分支的依赖，D 发布只会触发一次求值。
   */
  record u8_FollowState {
    transparent: bool;
    value: number;
  }

  derived u8_followState: u8_FollowState = u8_transparent
    ? { transparent: true, value: u8_dataByte() }
    : { transparent: false, value: 0 };

  fn u8_publishAll() {
    if u8_outputsEnabled {
      u8_drive_setDrive(u8_stored);
    } else {
      u8_drive_setDrive(-1);
    }
  }

  process u8_start on u8_started {
    // 573 只在 LE 为高时透明跟随 D。上电时 LE 已低的口不应伪造一次「锁存」；
    // 保持 stored=0 的确定性初始值，等第一个透明相位或下降沿再更新。latch 仍发布
    // 这个确定初始值，便于观察端不需要区分「尚未发布」与「锁存为 0」。
    if fusedWire49 == Logic.high {
