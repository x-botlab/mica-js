  /** 透明阶段：LE 为高时 D 的任意变化直接传到 Q。 */
  process u8_follow on u8_followState {
    if !u8_followState.transparent {
      return;
    }
    const current = u8_followState.value;
    u8_stored = current;
    u8_latch.send(current);
    u8_publishAll();
