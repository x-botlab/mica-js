    else if (u8_drive >= 0 ? ((u8_drive >> 5) & 1) : 4) == 2 { weakHigh = true; }
    else if (u8_drive >= 0 ? ((u8_drive >> 5) & 1) : 4) == 3 { weakLow = true; }
    if strongLow { return 0; }
    if strongHigh { return 1; }
    if weakHigh { return 1; }
    if weakLow { return 0; }
    return 2;
  }
