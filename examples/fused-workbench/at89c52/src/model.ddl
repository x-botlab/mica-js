device At89c52(clockFrequency: number default 12000000) {
  memory code[0x2000];
  memory iram[0x100];
  memory sfr[0x80];
  memory periph[0x100];
  state pc: number = 0;
  process start {
    store8(sfr, 0x01, 0x07);
    store8(sfr, 0x00, 0xff);
    store8(sfr, 0x10, 0xff);
    store8(sfr, 0x20, 0xff);
    store8(sfr, 0x30, 0xff);
  }
  pin VCC;
  pin GND;
  pin P0_0(low: 1.5, high: 3.5);
  pin P0_1(low: 1.5, high: 3.5);
  pin P0_2(low: 1.5, high: 3.5);
  pin P0_3(low: 1.5, high: 3.5);
  pin P0_4(low: 1.5, high: 3.5);
  pin P0_5(low: 1.5, high: 3.5);
  pin P0_6(low: 1.5, high: 3.5);
  pin P0_7(low: 1.5, high: 3.5);
  pin P1_0(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P1_1(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P1_2(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P1_3(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P1_4(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P1_5(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P1_6(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P1_7(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P2_0(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P2_1(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P2_2(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P2_3(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P2_4(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P2_5(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P2_6(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P2_7(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P3_0(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P3_1(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P3_2(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P3_3(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P3_4(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P3_5(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P3_6(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin P3_7(low: 1.5, high: 3.5) = [resistor(to: VCC, resistance: 10000)];
  pin RST;
  pin XTAL1;
  pin XTAL2;
  pin PSEN;
  pin ALE;
  pin EA;
}
