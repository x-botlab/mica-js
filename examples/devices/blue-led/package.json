{
  "publisher": "example",
  "name": "blue-led",
  "version": "1.0.0",
  "description": "蓝色 LED：阳极–阴极按等效串联电阻导通，亮度取正向电流相对额定电流的比值（钳到 0..1）。平台电气合同只支持线性电阻，因此不含正向压降、反向截止与发光效率。",
  "license": "MIT",
  "engines": {
    "mica": "^0.3.0"
  },
  "displayName": "蓝色 LED",
  "designatorPrefix": "D",
  "properties": {
    "forwardResistance": {
      "type": "number",
      "title": "正向等效电阻",
      "description": "阳极–阴极的等效串联电阻，决定正向电流。线性模型，不含二极管压降；默认 500 Ω 让 5 V / 330 Ω 接法落在约 3.0 V、6 mA。",
      "default": 500,
      "nullable": false,
      "unit": "ohm",
      "min": 0.001,
      "max": 1000000000,
      "step": 1
    },
    "ratedCurrent": {
      "type": "number",
      "title": "额定电流",
      "description": "达到该正向电流时亮度为 1，更大的电流仍按 1 处理。",
      "default": 0.02,
      "nullable": false,
      "unit": "A",
      "min": 0.0001,
      "max": 1,
      "step": 0.001
    }
  },
  "pins": {
    "anode": {
      "label": "A",
      "description": "阳极：相对阴极为正时导通并发光"
    },
    "cathode": {
      "label": "K",
      "description": "阴极：接较低电位"
    }
  },
  "model": {
    "entry": "model.js",
    "types": {},
    "methods": {
      "getBrightness": {
        "params": {
          "type": "null"
        },
        "returns": {
          "type": "number"
        }
      },
      "getCurrent": {
        "params": {
          "type": "null"
        },
        "returns": {
          "type": "number"
        }
      },
      "getVoltage": {
        "params": {
          "type": "null"
        },
        "returns": {
          "type": "number"
        }
      }
    },
    "events": {
      "onDidBrightness": {
        "type": "number"
      },
      "onDidCurrent": {
        "type": "number"
      },
      "onDidVoltage": {
        "type": "number"
      }
    }
  },
  "type": "module"
}
