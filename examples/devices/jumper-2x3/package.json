{
  "publisher": "example",
  "name": "jumper-2x3",
  "version": "1.0.0",
  "description": "2×3 跳线排针：两路跳线。通道 1 固定短接 1-3（P1.0 到红外发送链）；通道 2 由 vs1838 初值选择 4-6（VS1838）或 2-4（CX20106A），运行期可通过 control2 切换并由 closedState2 回传。CT107D 的 J2。",
  "license": "MIT",
  "engines": {
    "mica": "^1.0.0"
  },
  "displayName": "2×3 跳线排针",
  "designatorPrefix": "J",
  "properties": {
    "vs1838": {
      "type": "boolean",
      "title": "选择 VS1838",
      "description": "true 表示 4-6 短接（VS1838 输出到 P1.1），false 表示 2-4 短接（CX20106A 输出到 P1.1）。",
      "default": true,
      "nullable": false
    },
    "resistance": {
      "type": "number",
      "title": "短接电阻",
      "description": "插上跳线帽时两端的等效导通电阻。",
      "default": 0.05,
      "nullable": false,
      "unit": "ohm",
      "min": 0.001,
      "max": 1000000,
      "step": 0.01
    }
  },
  "pins": {
    "p1": {
      "label": "1",
      "description": "左列 1：发送通路，固定短接到 3"
    },
    "p2": {
      "label": "2",
      "description": "右列 2：CX20106A 输出（N_B1）"
    },
    "p3": {
      "label": "3",
      "description": "左列 3：MCU P1.0（P10）"
    },
    "p4": {
      "label": "4",
      "description": "右列 4：MCU P1.1（P11），接收端公共脚"
    },
    "p5": {
      "label": "5",
      "description": "左列 5：红外发射管支路（N_A2）"
    },
    "p6": {
      "label": "6",
      "description": "右列 6：VS1838 输出（N_B2）"
    }
  },
  "model": {
    "entry": "model.js",
    "types": {},
    "methods": {
      "selectVs1838": {
        "params": {
          "type": "boolean"
        },
        "returns": {
          "type": "null"
        }
      },
      "isVs1838": {
        "params": {
          "type": "null"
        },
        "returns": {
          "type": "boolean"
        }
      }
    },
    "events": {
      "onDidClosedState2": {
        "type": "boolean"
      }
    }
  },
  "type": "module"
}
