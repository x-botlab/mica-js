{
  "publisher": "example",
  "name": "ir-emitter",
  "version": "1.0.0",
  "description": "红外发射端的数据通信逻辑模型：mod 是数字调制输入，高电平表示载波存在；宿主也可用 setCarrier 提交同一逻辑请求。载波状态经 carrier 输出通道与 onDidCarrier 事件交付，可由测试夹具桥接到 vs1838/cx20106a 的 setCarrier。供电由真实 VCC/GND 网络采样决定，掉电时载波为假。不模拟红外 LED、正向电流、发光强度、38 kHz 波形、光路或任何具体红外协议。",
  "license": "MIT",
  "engines": {
    "mica": "^1.0.0"
  },
  "displayName": "红外发射数据调制端",
  "designatorPrefix": "U",
  "properties": {
    "lowThreshold": {
      "type": "number",
      "title": "低电平上限",
      "description": "mod 采样电压低于该值判为逻辑低。",
      "default": 0.8,
      "nullable": false,
      "unit": "V",
      "min": 0,
      "max": 5,
      "step": 0.1
    },
    "highThreshold": {
      "type": "number",
      "title": "高电平下限",
      "description": "mod 采样电压高于该值判为逻辑高；VCC 不足时载波为假。",
      "default": 2,
      "nullable": false,
      "unit": "V",
      "min": 0,
      "max": 5,
      "step": 0.1
    }
  },
  "pins": {
    "mod": {
      "label": "MOD",
      "description": "数字调制输入（高有效）：高表示载波存在，可直接接 MCU GPIO 或 J2 第 5 脚 N_A2 支路"
    },
    "vcc": {
      "label": "VCC",
      "description": "电源正端，标称 5 V"
    },
    "gnd": {
      "label": "GND",
      "description": "电源地"
    }
  },
  "model": {
    "entry": "model.js",
    "types": {},
    "methods": {
      "setCarrier": {
        "params": {
          "type": "boolean"
        },
        "returns": {
          "type": "null"
        }
      },
      "isCarrier": {
        "params": {
          "type": "null"
        },
        "returns": {
          "type": "boolean"
        }
      }
    },
    "events": {
      "onDidCarrier": {
        "type": "boolean"
      }
    }
  },
  "type": "module"
}
