{
  "publisher": "example",
  "name": "uart-probe",
  "version": "1.0.0",
  "description": "独立 UART 探针：rxd 以 8N1、LSB first 复原字节并从 tx 端口逐字节发布；txd 可经 send 输入通道注入字节，从 rx 端口逐字节回报。空闲高，下降沿开帧，在位中点采样并校验停止位；未知电平按低，帧错误静默丢弃。注入使用 now()+ticks 定时，新命令按序号取消旧注入。",
  "license": "MIT",
  "engines": {
    "mica": "^0.3.0"
  },
  "displayName": "UART 串口探针",
  "designatorPrefix": "U",
  "properties": {
    "baud": {
      "type": "number",
      "title": "波特率",
      "description": "位时间按 round(1e12 / baud) ps 换算；默认 9600。",
      "default": 9600,
      "nullable": false,
      "unit": "baud",
      "min": 1,
      "max": 1000000000,
      "step": 1
    },
    "driveResistance": {
      "type": "number",
      "title": "驱动电阻",
      "description": "TXD 拉高到 VCC 或拉低到 GND 时的等效串联电阻。",
      "default": 25,
      "nullable": false,
      "unit": "ohm",
      "min": 0.001,
      "max": 1000000000,
      "step": 1
    }
  },
  "pins": {
    "rxd": {
      "label": "RXD",
      "description": "接收输入，接 MCU 的 TXD；8N1，阈值 0.8/2.0 V"
    },
    "txd": {
      "label": "TXD",
      "description": "注入输出，接 MCU 的 RXD；空闲高"
    },
    "vcc": {
      "label": "VCC",
      "description": "5 V 电源"
    },
    "gnd": {
      "label": "GND",
      "description": "地"
    }
  },
  "model": {
    "entry": "model.js",
    "types": {},
    "methods": {
      "send": {
        "params": {
          "type": "binary"
        },
        "returns": {
          "type": "null"
        }
      }
    },
    "events": {
      "onDidTx": {
        "type": "binary"
      },
      "onDidRx": {
        "type": "binary"
      }
    }
  },
  "type": "module"
}
