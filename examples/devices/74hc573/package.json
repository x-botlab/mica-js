{
  "publisher": "example",
  "name": "74hc573",
  "version": "1.0.0",
  "description": "八路 D 型透明锁存器：LE 高电平时 Q 跟随 D，LE 下降沿锁存当前字节；OE# 高电平时八路输出全部释放为高阻。零传播延迟，不含驱动强度与电源电流。",
  "license": "MIT",
  "engines": {
    "mica": "^0.3.0"
  },
  "displayName": "74HC573 八路透明锁存器",
  "designatorPrefix": "U",
  "properties": {
    "outputResistance": {
      "type": "number",
      "title": "输出电阻",
      "description": "推挽输出的等效串联电阻，决定高/低电平的负载能力。",
      "default": 25,
      "nullable": false,
      "unit": "ohm",
      "min": 0.001,
      "max": 1000000000,
      "step": 1
    },
    "lowThreshold": {
      "type": "number",
      "title": "低电平上限",
      "description": "采样电压低于该值判为逻辑低。",
      "default": 0.8,
      "nullable": false,
      "unit": "V",
      "min": 0,
      "max": 5,
      "step": 0.1
    },
    "highThreshold": {
      "type": "number",
      "title": "高电平下限",
      "description": "采样电压高于该值判为逻辑高。",
      "default": 2,
      "nullable": false,
      "unit": "V",
      "min": 0,
      "max": 5,
      "step": 0.1
    }
  },
  "pins": {
    "oe": {
      "label": "OE#",
      "description": "输出使能，低有效"
    },
    "d0": {
      "label": "D0"
    },
    "d1": {
      "label": "D1"
    },
    "d2": {
      "label": "D2"
    },
    "d3": {
      "label": "D3"
    },
    "d4": {
      "label": "D4"
    },
    "d5": {
      "label": "D5"
    },
    "d6": {
      "label": "D6"
    },
    "d7": {
      "label": "D7"
    },
    "le": {
      "label": "LE",
      "description": "锁存使能，高电平透明"
    },
    "q0": {
      "label": "Q0"
    },
    "q1": {
      "label": "Q1"
    },
    "q2": {
      "label": "Q2"
    },
    "q3": {
      "label": "Q3"
    },
    "q4": {
      "label": "Q4"
    },
    "q5": {
      "label": "Q5"
    },
    "q6": {
      "label": "Q6"
    },
    "q7": {
      "label": "Q7"
    },
    "vcc": {
      "label": "VCC"
    },
    "gnd": {
      "label": "GND"
    }
  },
  "model": {
    "entry": "model.js",
    "types": {},
