{
  "kind": "device",
  "id": "relay",
  "version": "1.0.0",
  "displayName": "电磁继电器（双极常开）",
  "designatorPrefix": "K",
  "description": "电磁继电器：线圈由开集输出拉低时吸合，两组常开触点随之闭合；端口 energized 报告吸合状态。CT107D 的 K1（值 RELAY-SPDT）：线圈接 N_RELAY 与继电器电源，触点把 m2 接到 GND。不模拟吸合延时、弹跳、线圈电感与反激电压。",
  "tags": ["relay", "actuator", "ct107d"],
  "properties": {
    "coilResistance": {
      "type": "number",
      "required": false,
      "default": 400,
      "title": "线圈电阻",
      "unit": "ohm",
      "description": "线圈两端的等效直流电阻，决定吸合电流。",
      "editor": { "kind": "number", "min": 0.001, "max": 1000000000, "step": 1 }
    },
    "contactResistance": {
      "type": "number",
      "required": false,
      "default": 0.05,
      "title": "触点闭合电阻",
      "unit": "ohm",
      "description": "触点吸合时的等效导通电阻。",
      "editor": { "kind": "number", "min": 0.001, "max": 1000000, "step": 0.01 }
    },
    "openResistance": {
      "type": "number",
      "required": false,
      "default": 1000000000,
      "title": "触点断开电阻",
      "unit": "ohm",
      "description": "触点释放时的等效绝缘电阻；用有限值避免孤立支路。",
      "editor": { "kind": "number", "min": 1, "max": 1000000000000, "step": 1000 }
    },
    "lowThreshold": {
      "type": "number",
      "required": false,
      "default": 0.8,
      "title": "低电平上限",
      "unit": "V",
      "description": "线圈驱动端采样电压低于该值判为逻辑低。",
      "editor": { "kind": "number", "min": 0, "max": 5, "step": 0.1 }
    },
    "highThreshold": {
      "type": "number",
      "required": false,
      "default": 2,
      "title": "高电平下限",
      "unit": "V",
      "description": "线圈正端采样电压高于该值判为逻辑高。",
      "editor": { "kind": "number", "min": 0, "max": 5, "step": 0.1 }
    }
  },
  "pins": {
    "coil": {
      "label": "COIL-",
      "description": "线圈驱动端（引脚 4），接 ULN2003 OUT5",
      "group": "Coil"
    },
    "vcc": { "label": "COIL+", "description": "线圈正端（引脚 5）", "group": "Coil" },
    "com": { "label": "COM", "description": "触点公共端（引脚 3），板上接 m2", "group": "Contact" },
    "no": { "label": "NO", "description": "常开触点（引脚 6），板上接 GND", "group": "Contact" },
    "com2": {
      "label": "COM2",
      "description": "第二组触点公共端（引脚 1），板上接 GND",
      "group": "Contact"
    },
    "no2": {
      "label": "NO2",
      "description": "第二组常开触点（引脚 2），板上悬空",
      "group": "Contact"
    }
  },
  "ports": {
    "energized": {
      "direction": "output",
      "type": "boolean",
      "delivery": "level",
      "title": "吸合",
      "description": "线圈驱动端非高且线圈正端为高时为 true，即触点闭合。"
    }
  },
  "symbol": {
    "bounds": { "x": -40, "y": -30, "width": 80, "height": 60 },
    "graphics": [
      { "type": "rect", "x": -16, "y": -26, "width": 32, "height": 16 },
      { "type": "line", "from": [-40, -18], "to": [-16, -18] },
      { "type": "line", "from": [16, -18], "to": [40, -18] },
      { "type": "line", "from": [0, -10], "to": [0, -2] },
      { "type": "line", "from": [-40, 6], "to": [-10, 6] },
      { "type": "line", "from": [-10, 2], "to": [-10, 10] },
      { "type": "line", "from": [40, 6], "to": [10, 6] },
      { "type": "line", "from": [10, 6], "to": [-6, 0] },
      { "type": "line", "from": [-40, 20], "to": [-10, 20] },
      { "type": "line", "from": [-10, 16], "to": [-10, 24] },
      { "type": "line", "from": [40, 20], "to": [10, 20] },
      { "type": "line", "from": [10, 20], "to": [-6, 14] }
    ],
    "pins": {
      "coil": { "position": [-40, -18], "direction": "left", "label": { "visible": false } },
      "vcc": { "position": [40, -18], "direction": "right", "label": { "visible": false } },
      "no": { "position": [-40, 6], "direction": "left", "label": { "visible": false } },
      "com": { "position": [40, 6], "direction": "right", "label": { "visible": false } },
      "com2": { "position": [-40, 20], "direction": "left", "label": { "visible": false } },
      "no2": { "position": [40, 20], "direction": "right", "label": { "visible": false } }
    },
    "annotations": { "designator": { "position": [0, -32], "align": "center" } }
  }
}
