{
  "kind": "device",
  "id": "jumper-2x3",
  "version": "1.0.0",
  "displayName": "2×3 跳线排针",
  "designatorPrefix": "J",
  "description": "2×3 跳线排针：两路跳线。通道 1 固定短接 1-3（P1.0 到红外发送链）；通道 2 由 vs1838 初值选择 4-6（VS1838）或 2-4（CX20106A），运行期可通过 control2 切换并由 closedState2 回传。CT107D 的 J2。",
  "tags": ["jumper", "header", "infrared", "ct107d"],
  "properties": {
    "vs1838": {
      "type": "boolean",
      "required": false,
      "default": true,
      "title": "选择 VS1838",
      "description": "true 表示 4-6 短接（VS1838 输出到 P1.1），false 表示 2-4 短接（CX20106A 输出到 P1.1）。",
      "editor": {
        "kind": "checkbox"
      }
    },
    "resistance": {
      "type": "number",
      "required": false,
      "default": 0.05,
      "title": "短接电阻",
      "unit": "ohm",
      "description": "插上跳线帽时两端的等效导通电阻。",
      "editor": {
        "kind": "number",
        "min": 0.001,
        "max": 1000000,
        "step": 0.01
      }
    }
  },
  "pins": {
    "p1": {
      "label": "1",
      "description": "左列 1：发送通路，固定短接到 3",
      "group": "Header"
    },
    "p2": {
      "label": "2",
      "description": "右列 2：CX20106A 输出（N_B1）",
      "group": "Header"
    },
    "p3": {
      "label": "3",
      "description": "左列 3：MCU P1.0（P10）",
      "group": "Header"
    },
    "p4": {
      "label": "4",
      "description": "右列 4：MCU P1.1（P11），接收端公共脚",
      "group": "Header"
    },
    "p5": {
      "label": "5",
      "description": "左列 5：红外发射管支路（N_A2）",
      "group": "Header"
    },
    "p6": {
      "label": "6",
      "description": "右列 6：VS1838 输出（N_B2）",
      "group": "Header"
    }
  },
  "ports": {
    "control2": {
      "direction": "input",
      "type": "boolean",
      "delivery": "level",
      "title": "切换通道 2",
      "description": "true 表示 4-6（VS1838），false 表示 2-4（CX20106A）。"
    },
    "closedState2": {
      "direction": "output",
      "type": "boolean",
      "delivery": "level",
      "title": "通道 2 当前状态",
      "description": "true 表示当前选择 4-6，false 表示选择 2-4。"
    }
  },
