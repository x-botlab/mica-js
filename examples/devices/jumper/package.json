{
  "publisher": "example",
  "name": "jumper",
  "version": "1.0.0",
  "description": "两脚跳线：closed 为装配初值，运行期通过 setClosed 切换；isClosed 查询当前状态并发出 onDidClosedState。CT107D 的 J13（WR/IO 模式选择）与 JS1/JS2。断开时移除支路而非保留假电阻；切换立即生效，不模拟机械抖动与接触氧化。",
  "license": "MIT",
  "engines": {
    "mica": "^0.3.0"
  },
  "displayName": "两脚跳线",
  "designatorPrefix": "J",
  "properties": {
    "closed": {
      "type": "boolean",
      "title": "短接",
      "description": "true 表示插上跳线帽（两端导通），false 表示拔掉。",
      "default": true,
      "nullable": false
    },
    "resistance": {
      "type": "number",
      "title": "短接电阻",
      "description": "插上跳线帽时两端的等效导通电阻。",
      "default": 0.05,
      "nullable": false,
      "unit": "ohm",
      "min": 0.001,
      "max": 1000000,
      "step": 0.01
    }
  },
  "pins": {
    "a": {
      "label": "A"
    },
    "b": {
      "label": "B"
    }
  },
  "model": {
    "entry": "model.js",
    "types": {},
    "methods": {
      "setClosed": {
        "params": {
          "type": "boolean"
        },
        "returns": {
          "type": "null"
        }
      },
      "isClosed": {
        "params": {
          "type": "null"
        },
        "returns": {
          "type": "boolean"
        }
      }
    },
    "events": {
      "onDidClosedState": {
        "type": "boolean"
      }
    }
  },
  "type": "module"
}
