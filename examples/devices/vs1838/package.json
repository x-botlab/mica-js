{
  "publisher": "example",
  "name": "vs1838",
  "version": "1.0.0",
  "description": "一体化 38 kHz 红外接收头：光电二极管在封装内，照明经布尔输入通道 carrier 注入。载波出现 50 µs 后把开漏 OUT 拉低（短于 50 µs 的毛刺不触发），消失 200 µs 后释放；输入翻转会取消相反相位的挂起定时，重复电平不重臂。receiving 端口跟随解调状态，只在变化时发布。理想化：不模拟 38 kHz 频率匹配、AGC（连续载波约 60 ms 后停止响应）与脉冲整形，照明是布尔值而非波形。",
  "license": "MIT",
  "engines": {
    "mica": "^1.0.0"
  },
  "displayName": "VS1838 一体化红外接收头",
  "designatorPrefix": "U",
  "properties": {
    "outputResistance": {
      "type": "number",
      "title": "输出电阻",
      "description": "OUT 开漏拉低时的等效串联电阻。",
      "default": 25,
      "nullable": false,
      "unit": "ohm",
      "min": 0.001,
      "max": 1000000000,
      "step": 1
    },
    "lowThreshold": {
      "type": "number",
      "title": "低电平上限",
      "description": "预留阈值属性；本器件没有采样引脚，行为不使用该值。",
      "default": 0.8,
      "nullable": false,
      "unit": "V",
      "min": 0,
      "max": 5,
      "step": 0.1
    },
    "highThreshold": {
      "type": "number",
      "title": "高电平下限",
      "description": "预留阈值属性；本器件没有采样引脚，行为不使用该值。",
      "default": 2,
      "nullable": false,
      "unit": "V",
      "min": 0,
      "max": 5,
      "step": 0.1
    }
  },
  "pins": {
    "out": {
      "label": "OUT",
      "description": "解调输出（开漏）：检出载波拉低，空闲释放"
    },
    "vcc": {
      "label": "VCC",
      "description": "5 V 电源"
    },
    "gnd": {
      "label": "GND",
      "description": "地"
    }
  },
  "model": {
    "entry": "model.js",
    "types": {},
    "methods": {
      "setCarrier": {
        "params": {
          "type": "boolean"
        },
        "returns": {
          "type": "null"
        }
      },
      "isReceiving": {
        "params": {
          "type": "null"
        },
        "returns": {
          "type": "boolean"
        }
      }
    },
    "events": {
      "onDidReceiving": {
        "type": "boolean"
      }
    }
  },
  "type": "module"
}
