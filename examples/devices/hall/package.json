{
  "publisher": "example",
  "name": "hall",
  "version": "1.0.0",
  "description": "三脚开关型霍尔传感器：VCC/GND 供电，OUT 为低有效开漏输出。外加磁场达到 operatePoint 时吸合（OUT 拉低），降到 releasePoint 及以下释放，两点之间保持迟滞；setField 提交磁场，供电由真实 VCC/GND 网络采样决定，掉电释放输出并清除内部锁存。不模拟线性磁场、磁极方向、温度漂移、输出边沿与电源电流。",
  "license": "MIT",
  "engines": {
    "mica": "^0.3.0"
  },
  "displayName": "三脚开关型霍尔传感器",
  "designatorPrefix": "U",
  "properties": {
    "field": {
      "type": "number",
      "title": "初始磁场",
      "description": "创建时的外加磁通密度；运行期通过 setField 更新。",
      "default": 0,
      "nullable": false,
      "unit": "mT",
      "min": 0,
      "max": 1000,
      "step": 0.1
    },
    "operatePoint": {
      "type": "number",
      "title": "吸合点 Bop",
      "description": "磁场达到该值时 OUT 拉低；必须大于释放点。",
      "default": 15,
      "nullable": false,
      "unit": "mT",
      "min": 0,
      "max": 1000,
      "step": 0.1
    },
    "releasePoint": {
      "type": "number",
      "title": "释放点 Brp",
      "description": "磁场降到该值及以下时 OUT 释放；与吸合点之间形成迟滞。",
      "default": 10,
      "nullable": false,
      "unit": "mT",
      "min": 0,
      "max": 1000,
      "step": 0.1
    },
    "outputResistance": {
      "type": "number",
      "title": "输出电阻",
      "description": "OUT 开漏拉低时的等效串联电阻。",
      "default": 25,
      "nullable": false,
      "unit": "ohm",
      "min": 0.001,
      "max": 1000000000,
      "step": 1
    },
    "lowThreshold": {
      "type": "number",
      "title": "低电平上限",
      "description": "VCC/GND 采样电压低于该值判为逻辑低。",
      "default": 0.8,
      "nullable": false,
      "unit": "V",
      "min": 0,
      "max": 5,
      "step": 0.1
    },
    "highThreshold": {
      "type": "number",
      "title": "高电平下限",
      "description": "VCC 采样电压高于该值判为逻辑高；VCC 不足时输出释放。",
      "default": 2,
      "nullable": false,
      "unit": "V",
      "min": 0,
      "max": 5,
      "step": 0.1
    }
  },
  "pins": {
    "vcc": {
      "label": "VCC",
      "description": "电源正端（引脚 1），标称 5 V"
    },
    "gnd": {
      "label": "GND",
      "description": "电源地（引脚 2）"
    },
    "out": {
      "label": "OUT",
      "description": "开关输出（引脚 3，开漏、低有效）：吸合拉低，释放后需外部上拉"
    }
  },
  "model": {
    "entry": "model.js",
    "types": {},
    "methods": {
      "setField": {
        "params": {
          "type": "number"
        },
        "returns": {
          "type": "null"
        }
      },
      "getField": {
        "params": {
          "type": "null"
        },
        "returns": {
          "type": "number"
        }
      },
      "isActive": {
        "params": {
          "type": "null"
        },
        "returns": {
          "type": "boolean"
        }
      }
    },
    "events": {
      "onDidActive": {
        "type": "boolean"
      }
    }
  },
  "type": "module"
}
