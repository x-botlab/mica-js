{
  "publisher": "example",
  "name": "iap15f2k61s2",
  "version": "0.2.0",
  "description": "STC15F2K60S2 系列 8051 单片机：JIT 取指执行 8051 指令集与中断，P0–P3、定时器 T0/T1/T2、双串口、ADC、PCA/CCP、SPI、IAP/EEPROM 与看门狗均按手册建模。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "mica": "^0.3.0"
  },
  "displayName": "IAP15F2K61S2",
  "designatorPrefix": "U",
  "properties": {
    "clockFrequency": {
      "type": "number",
      "title": "系统时钟 (Hz)",
      "description": "STC15 的 1T 系统时钟：指令耗时、定时器计数与串口波特率都按它换算。",
      "default": 11059200,
      "nullable": false,
      "min": 1000000,
      "max": 40000000,
      "step": 1,
      "unit": "Hz"
    },
    "firmware": {
      "type": "firmware",
      "title": "固件",
      "description": "BIN/HEX/ELF 固件：按 code 地址空间的绝对地址装载程序存储器。空值保持零初始化的代码空间（PC=0，执行 NOP），不是错误。",
      "default": null,
      "nullable": true,
      "maxBytes": 61440,
      "addressSpaces": {
        "code": {
          "title": "程序存储器",
          "start": 0,
          "size": 61440
        }
      },
      "addressSpace": "code",
      "loadAddress": 0,
      "group": "固件",
      "order": 0
    }
  },
  "pins": {
