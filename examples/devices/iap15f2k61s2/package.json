  "model": {
    "entry": "model.js",
    "types": {
      "SerialData": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "number"
          },
          "data": {
            "type": "binary"
          }
        }
      },
      "SerialChunk": {
        "type": "object",
        "properties": {
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "dropped": {
            "type": "number"
          },
          "data": {
            "type": "binary"
          }
        }
      },
      "SerialStatus": {
        "type": "object",
        "properties": {
          "capacity": {
            "type": "number"
          },
          "oldest": {
            "type": "number"
          },
          "next": {
            "type": "number"
          },
          "droppedTotal": {
            "type": "number"
          }
        }
      },
      "SerialReadParams": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string"
          },
          "cursor": {
            "type": "number"
          }
        }
      },
      "SerialChannelParams": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string"
          }
        }
      }
    },
    "methods": {
      "readSerial": {
        "params": {
          "ref": "SerialReadParams"
        },
        "returns": {
          "ref": "SerialChunk"
        }
      },
      "getSerialStatus": {
        "params": {
          "ref": "SerialChannelParams"
        },
        "returns": {
          "ref": "SerialStatus"
        }
      }
    },
    "events": {
      "onDidUart1Tx": {
        "ref": "SerialData"
      },
      "onDidUart1Rx": {
        "ref": "SerialData"
      }
    }
  }
