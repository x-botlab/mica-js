    "pins": {
      "a": { "position": [-40, 0], "direction": "left", "label": { "visible": false } },
      "b": { "position": [40, 0], "direction": "right", "label": { "visible": false } }
    },
    "annotations": { "designator": { "position": [0, 20], "align": "center" } }
