      { "type": "line", "from": [-40, 0], "to": [-20, 0] },
      { "type": "circle", "center": [-20, 0], "radius": 2 },
      { "type": "line", "from": [-20, 0], "to": [18, -12] },
      { "type": "circle", "center": [20, 0], "radius": 2 },
      { "type": "line", "from": [20, 0], "to": [40, 0] },
      { "type": "line", "from": [-6, -18], "to": [6, -18] }
