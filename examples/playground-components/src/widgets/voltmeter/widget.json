{
  "kind": "widget",
  "id": "voltmeter",
  "version": "1.0.0",
  "displayName": "数字电压表",
  "properties": {
    "label": { "type": "string", "required": false, "default": "电压", "title": "标签" },
    "color": { "type": "string", "required": false, "default": "#9fe3b5", "title": "读数颜色" },
    "precision": {
      "type": "number",
      "required": false,
      "default": 2,
      "title": "小数位数",
      "editor": { "kind": "number", "min": 0, "max": 4, "step": 1 }
    }
  },
  "ports": {
    "voltage": { "direction": "input", "type": "number", "delivery": "level", "title": "电压" }
  }
}
