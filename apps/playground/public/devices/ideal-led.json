{
  "reference": "demo:ideal-led",
  "type": "ideal-led",
  "displayName": "理想 LED",
  "designatorPrefix": "D",
  "properties": {
    "nominalVoltage": { "type": "number", "default": 5, "exclusiveMin": 0, "unit": "V" },
    "resistance": { "type": "number", "default": 1000, "exclusiveMin": 0, "unit": "ohm" },
    "brightnessSamples": {
      "type": "number",
      "title": "Exponential moving average samples (1 = instantaneous)",
      "default": 64,
      "min": 1,
      "max": 1000000,
      "step": 1
    }
  },
  "pins": {
    "anode": {
      "side": "left",
      "kind": "signal"
    },
    "cathode": {
      "side": "right",
      "kind": "signal"
    }
  },
  "resistors": {
    "load": { "pins": ["anode", "cathode"] }
  },
  "topics": {
    "brightness": {
      "direction": "output",
      "type": "number",
      "title": "Brightness",
      "state": "brightness"
    },
    "lit": {
      "direction": "output",
      "type": "boolean",
      "title": "点亮",
      "state": "lamp"
    }
  },
  "reset": {
    "state": "supported",
    "detail": "Restores digital lamp and exponential moving average brightness to zero"
  }
}
