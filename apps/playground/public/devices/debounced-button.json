{
  "reference": "demo:debounced-button",
  "type": "button-ir",
  "displayName": "去抖按钮",
  "designatorPrefix": "S",
  "pins": {
    "A": {
      "side": "left",
      "kind": "signal"
    },
    "B": {
      "side": "right",
      "kind": "signal"
    }
  },
  "topics": {
    "pressed": {
      "direction": "input",
      "type": "boolean",
      "title": "按下"
    },
    "closed": {
      "direction": "output",
      "type": "boolean",
      "title": "触点闭合"
    },
    "pressCount": {
      "direction": "output",
      "type": "number",
      "title": "按下次数"
    }
  },
  "connections": {
    "contact": {
      "pins": ["A", "B"],
      "initial": "open"
    }
  },
  "reset": {
    "state": "supported",
    "detail": "统一 IR 复位会恢复按键初始状态"
  },
  "properties": {
    "debounceTicks": {
      "type": "number",
      "default": 3,
      "min": 0,
      "max": 1000000,
      "step": 1
    }
  }
}
