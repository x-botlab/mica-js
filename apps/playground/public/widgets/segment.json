{
  "properties": {
    "digits": { "type": "integer", "title": "位数", "default": 4, "min": 1, "max": 24 },
    "color": { "type": "color", "title": "颜色", "default": "#FF3B30" },
    "thickness": {
      "type": "number",
      "title": "笔画粗细",
      "description": "笔画宽度占字高的比例",
      "default": 0.1,
      "min": 0.04,
      "max": 0.4
    },
    "spacing": {
      "type": "number",
      "title": "位间距",
      "description": "每个数位格子左右留白的比例",
      "default": 0.1,
      "min": 0,
      "max": 0.7
    },
    "pointSize": {
      "type": "number",
      "title": "小数点大小",
      "description": "占字高的比例，0 表示不画",
      "default": 0.06,
      "min": 0,
      "max": 0.3
    },
    "pointGap": {
      "type": "number",
      "title": "小数点间距",
      "description": "小数点与数字之间的距离，占字高的比例",
      "default": 0.05,
      "min": 0,
      "max": 0.3
    }
  },
  "ports": {
    "value": { "direction": "input", "type": "string", "title": "数值" },
    "count": { "direction": "input", "type": "number", "title": "计数" }
  }
}
