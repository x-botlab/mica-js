      "@mica-js/core/schematic": ["../../packages/core/src/schematic/index.ts"],
      "@mica-js/device": ["../../packages/device/src/index.ts"],
      "@mica-js/ir": ["../../packages/ir/src/index.ts"],
      "@mica-js/simulator": ["../../packages/simulator/src/index.ts"],
      "@mica-js/simulator/sandbox": ["../../packages/simulator/src/sandbox.ts"],
