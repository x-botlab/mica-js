{
  "name": "mica-js",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "docs:html": "sphinx-build -M html docs/spec dist/docs -n -W --keep-going",
    "docs:pdf": "sphinx-build -M latexpdf docs/spec dist/docs -n -W --keep-going",
    "test": "pnpm -r test",
    "test:conformance": "node tests/conformance/run.mjs",
    "test:conformance:report": "node tests/conformance/run.mjs --report",
    "test:conformance:strict": "node tests/conformance/run.mjs --require-adapter",
    "typecheck:conformance": "tsc -p tests/conformance/tsconfig.json && tsc -p docs/spec/contracts/tsconfig.json",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "pack-packages": "pnpm -r build && changeset pack --out-dir .release-pack",
    "release": "pnpm run pack-packages && changeset publish --from-pack-dir .release-pack"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@mica-js/conformance": "workspace:*",
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.2"
  }
}
